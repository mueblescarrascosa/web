---
// «Recorre la casa»: la maqueta de la portada. El dibujo lo hace src/scripts/casa.js.
// Foto del olivar (casa-olivar): «Olivares de regadío en Sierra Mágina, Jaén», de Avenir Démodé, CC0 (dominio público):
// https://www.flickr.com/photos/21025622@N08/34467255692
// casa-juegos es una captura de nuestro propio juego «Combina tu cocina».
import { r } from '../lib/sitio.js';

interface Props { servicios: [string, string, string][] }
const { servicios } = Astro.props;
const img = (n: string) => r(`/img/${n}-800.webp`);

const JUEGOS = [['Combina tu cocina', '/combina-tu-cocina/'], ['¿Qué cocina va contigo?', '/que-cocina-va-contigo/'], ['Elige tu encimera', '/elige-tu-encimera/'], ['Diseña tu armario', '/disena-tu-armario/'], ['Diseña tu salón', '/disena-tu-salon/'], ['Combina tu baño', '/combina-tu-bano/'], ['Configura tu puerta', '/configura-tu-puerta/'], ['Compara dos diseños', '/compara/']];
const L = (l: string[][]) => l.map(([t, h]) => [t, r(h)]);
const salas = {
  cocina: { n: 'Cocina', k: 'El corazón de la casa', d: 'Frentes, encimeras y tiradores a tu gusto, medidos al milímetro y montados por nuestro equipo.', foto: img('pxl-20260421-160853451'), alt: 'Cocina blanca con isla y encimera clara',
    l: L([['Cocinas a medida', '/cocinas/'], ['Combina tu cocina', '/combina-tu-cocina/'], ['¿Qué cocina va contigo?', '/que-cocina-va-contigo/'], ['Elige tu encimera', '/elige-tu-encimera/']]) },
  salon: { n: 'Salón', k: 'Para estar', d: 'Muebles de salón y librerías que aprovechan la pared entera.', foto: img('img20230222124240'), alt: 'Mueble de salón a medida con televisión',
    l: L([['Diseña tu salón', '/disena-tu-salon/'], ['Muebles de exposición', '/destacado-2/']]) },
  vestidor: { n: 'Vestidor', k: 'Todo a la vista', d: 'Abierto o con puertas, con barras, baldas, cajones y zapatero.', foto: img('pxl-20250117-103034187'), alt: 'Interior de armario con baldas y cajones',
    l: L([['Armarios y vestidores', '/armarios/'], ['Diseña tu armario', '/disena-tu-armario/'], ['Compara dos diseños', '/compara/']]) },
  taller: { n: 'El taller', k: 'Nosotros · desde 1969', d: 'Tres generaciones de carpinteros en Villanueva del Arzobispo. Aquí se corta, se monta y se repasa cada mueble antes de llegar a tu casa.', foto: img('img-20210815-113601'), alt: 'Puertas de madera en el taller',
    l: L([['Quiénes somos', '/acerca-de/'], ['Carpintería a medida en Jaén', '/destacado/']]) },
  galeria: { n: 'Galería', k: 'Trabajos hechos', d: 'Cocinas, armarios y puertas que ya están en casa de nuestros clientes.', foto: img('pxl-20241128-172237679'), alt: 'Cocina negra con isla de mármol',
    l: L([['Cocinas', '/cocinas/'], ['Armarios y vestidores', '/armarios/'], ['Puertas', '/puertas/'], ['Otros trabajos', '/miscelanea/'], ['Diseños 3D', '/disenos-3d/']]) },
  bano: { n: 'Baño', k: 'Agua y orden', d: 'Muebles que aguantan la humedad y aprovechan cada centímetro.', foto: img('ana-y-david-bano'), alt: 'Diseño de baño con mueble de dos senos',
    l: L([['Muebles de baño a medida', '/muebles-de-bano-a-medida/'], ['Combina tu baño', '/combina-tu-bano/']]) },
  dormitorio: { n: 'Dormitorio', k: 'Descanso', d: 'Armarios empotrados, cabeceros y mesitas a juego.', foto: img('pxl-20250819-112656696'), alt: 'Dormitorio con cabecero de madera',
    l: L([['Diseña tu armario', '/disena-tu-armario/'], ['Armarios a medida', '/armarios/']]) },
  ocio: { n: 'Sala de juegos', k: 'Para trastear', d: 'Prueba combinaciones, compara y guarda las que te gusten. Sin compromiso.', foto: img('casa-juegos'), alt: 'Juego «Combina tu cocina»',
    l: L(JUEGOS), chips: true },
  despacho: { n: 'Despacho', k: 'Dudas y lecturas', d: 'Respuestas claras, calculadoras de medidas, el blog y tu proyecto guardado.', foto: img('pxl-20250213-165920096'), alt: 'Mesa de madera maciza hecha en el taller',
    l: L([['Preguntas frecuentes', '/preguntas-frecuentes/'], ['Blog', '/entradas-del-blog/'], ['Mi proyecto', '/mi-proyecto/'], ['Diseño 3D de tu proyecto', '/disenos-3d/']]) },
  entrada: { n: 'Entrada', k: 'Llama cuando quieras', d: 'Escríbenos, llámanos o pide cita para que vayamos a medir.', foto: img('img20230702212113-1'), alt: 'Puerta de entrada de madera', ext: true,
    l: L([['Contacto', '/contacto/'], ['Pide cita para medir', '/contacto/#cita'], ['Puertas a medida', '/puertas/']]) },
  jardin: { n: 'Dónde estamos', k: 'Jaén y alrededores', d: 'El taller está en Villanueva del Arzobispo. Montamos en toda la provincia.', foto: img('casa-olivar'), alt: 'Olivares de Sierra Mágina, en Jaén', ext: true,
    l: L([['Dónde trabajamos', '/donde-trabajamos/'], ['Cómo llegar al taller', '/contacto/']]) },
};
const fotos = { abuelo: img('abueloacs-page-0001'), fachada: img('img20220708063232-1-1'), g1: img('cocina-moka'), g2: img('armario-corredera-con-japonesa-madera-oscura-abierto-1-2'), g3: img('pxl-20260209-172030793') };
const datos = JSON.stringify({ salas, fotos });
const dentro = Object.entries(salas).filter(([, s]) => !('ext' in s));
const fuera = Object.entries(salas).filter(([, s]) => 'ext' in s);
---
<section class="casa" id="servicios" aria-labelledby="casa-titulo">
  <div class="ancho casa-cabeza">
    <div>
      <span class="etiqueta">Lo que hacemos</span>
      <h2 id="casa-titulo">Todo a medida.<br /><span class="casa-suave">Nada de catálogo.</span></h2>
    </div>
    <p class="casa-intro">Recorre la casa: cada habitación es un trabajo que hacemos. Toca una para verla de cerca.</p>
  </div>

  <div class="casa-escena">
    <svg class="casa-svg" role="group" aria-label="Maqueta de una casa con sus habitaciones"></svg>
    <aside class="casa-panel" aria-hidden="true" aria-live="polite">
      <div class="casa-foto"><img alt="" width="800" height="500" /></div>
      <div class="casa-cuerpo">
        <span class="casa-k"></span>
        <h3 class="casa-t"></h3>
        <p class="casa-d"></p>
        <div class="casa-enlaces"></div>
        <button type="button" class="casa-volver">← Volver a la casa</button>
      </div>
    </aside>
  </div>

  <div class="ancho casa-pie">
    <ul class="casa-servicios">
      {servicios.map(([h, t, d], i) => (
        <li><a href={r(h)}><span class="num">0{i + 1}</span><span class="nombre">{t}</span><span class="desc">{d}</span></a></li>
      ))}
    </ul>
    <div class="casa-ir">
      <span>Ir a una habitación</span>
      <ul>
        {dentro.map(([id, s]) => <li><button type="button" data-sala={id}>{s.n}</button></li>)}
        {fuera.map(([id, s]) => <li><button type="button" data-sala={id}>{s.n}</button></li>)}
      </ul>
    </div>
  </div>
  <script type="application/json" set:html={datos} />
</section>

<script>import '../scripts/casa.js';</script>

<style is:global>
.casa {
  --papel: #ece5d8; --tinta: #1d1b18; --tinta-suave: #6b6359;
  position: relative; overflow: hidden; color: var(--tinta);
  padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  background:
    radial-gradient(70% 60% at 50% 55%, rgba(255, 252, 245, .75), transparent 70%),
    linear-gradient(rgba(90, 70, 45, .07) 1px, transparent 1px) 0 0 / 34px 34px,
    linear-gradient(90deg, rgba(90, 70, 45, .07) 1px, transparent 1px) 0 0 / 34px 34px,
    var(--papel);
}
.casa .etiqueta { color: #8a6a4c; }
.casa h2 { color: var(--tinta); margin: 0; }
.casa-suave { color: #9a8f81; }
.casa-cabeza { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
.casa-intro { max-width: 34ch; margin: 0; color: var(--tinta-suave); line-height: 1.55; }
.casa-escena { position: relative; max-width: 1480px; margin: clamp(1rem, 3vw, 2.5rem) auto 0; padding-inline: clamp(.5rem, 2vw, 2rem); }
.casa-svg { width: 100%; height: auto; max-height: 82vh; display: block; margin: 0 auto; overflow: hidden; touch-action: manipulation; }
.casa .room { cursor: pointer; outline: none; transition: opacity .5s var(--t), transform .45s var(--t); }
.casa .room:hover, .casa .room:focus-visible { transform: translateY(-5px); }
.casa.zoom .room { transform: none; }
.casa .room .suelo { transition: filter .35s var(--t); }
.casa .room:hover .suelo, .casa .room:focus-visible .suelo { filter: brightness(1.08) saturate(1.15); }
.casa.zoom .room:not(.activa) { opacity: .18; }
.casa:not(.vista) .room, .casa:not(.vista) .etiquetas { opacity: 0; }
@keyframes casa-cae { from { opacity: 0; transform: translateY(-34px); } to { opacity: 1; transform: none; } }
.casa.vista .room { animation: casa-cae .9s var(--t) backwards; animation-delay: calc(var(--i) * 75ms); }
@keyframes casa-aparece { from { opacity: 0; } }
.casa.vista .etiquetas { animation: casa-aparece .6s 1.1s backwards; }
.casa .etiquetas { pointer-events: none; transition: opacity .35s; }
.casa.zoom .etiquetas { opacity: 0; }
.casa .etq line { stroke: rgba(29, 27, 24, .45); stroke-width: 1; }
.casa .etq circle { fill: var(--tinta); }
.casa .etq rect { fill: var(--tinta); transition: fill .25s; }
.casa .etq text { fill: #f3efe8; font: 600 11.5px var(--sans); }
.casa .etq .num { fill: var(--madera); font: 700 10px var(--display); }
.casa .etq.sobre rect, .casa .etq.sobre circle { fill: var(--azul); }
.casa .etq.sobre .num { fill: #b9c3ff; }
.casa.es-movil .etq text { font-size: 13px; } .casa.es-movil .etq .num { font-size: 11px; }

.casa-panel { position: absolute; z-index: 5; right: clamp(1rem, 3vw, 2.5rem); top: 50%; width: min(370px, calc(100% - 2rem));
  max-height: calc(100% - 1rem); overflow-y: auto; background: var(--fondo-2); color: var(--texto); border: 1px solid var(--linea); border-radius: 16px;
  box-shadow: 0 30px 70px rgba(40, 28, 15, .35); transform: translate(30px, -50%); opacity: 0; pointer-events: none; transition: transform .55s var(--t), opacity .4s; }
.casa-panel.abierto { transform: translate(0, -50%); opacity: 1; pointer-events: auto; }
.casa-foto { aspect-ratio: 16 / 10; overflow: hidden; background: var(--fondo-3); }
.casa-foto[hidden] { display: none; }
.casa-foto img { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.06); transition: transform 1.2s var(--t); }
.casa-panel.abierto .casa-foto img { transform: scale(1); }
.casa-cuerpo { padding: 1.2rem 1.4rem 1rem; }
.casa-k { color: var(--madera); font: 600 .74rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
.casa-t { font: 700 2rem/1.05 var(--display); letter-spacing: -.02em; margin: .35rem 0 .45rem; color: #fff; }
.casa-d { color: var(--suave); line-height: 1.5; margin: 0 0 1rem; font-size: .95rem; }
.casa-enlaces a { display: flex; justify-content: space-between; align-items: center; gap: .5rem; text-decoration: none; color: var(--texto);
  border-top: 1px solid var(--linea); padding: .8rem .1rem; font-weight: 500; min-height: 48px; transition: color .2s, padding .3s var(--t); }
.casa-enlaces a:last-child { border-bottom: 1px solid var(--linea); }
.casa-enlaces a span { color: var(--madera); transition: transform .3s var(--t); }
.casa-enlaces a:hover { color: #fff; padding-left: .4rem; } .casa-enlaces a:hover span { transform: translateX(4px); }
.casa-enlaces.chips { display: flex; flex-wrap: wrap; gap: .45rem; }
.casa-enlaces.chips a { border: 1px solid var(--linea); border-radius: 999px; padding: .5rem .9rem; min-height: 44px; font-size: .9rem; }
.casa-enlaces.chips a span { display: none; }
.casa-volver { margin-top: .5rem; background: none; border: 0; color: var(--suave); font: 500 .9rem var(--sans); cursor: pointer; padding: .6rem 0; min-height: 44px; }
.casa-volver:hover { color: var(--texto); }

.casa-pie { margin-top: clamp(1rem, 3vw, 2rem); display: grid; gap: 2rem; }
.casa-servicios { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(29, 27, 24, .16); }
.casa-servicios a { display: grid; gap: .35rem; padding: 1.2rem 1rem 1.2rem 0; text-decoration: none; color: var(--tinta); }
.casa-servicios .num { font: 500 .8rem var(--sans); color: #8a6a4c; letter-spacing: .1em; }
.casa-servicios .nombre { font: 650 1.45rem/1.1 var(--display); letter-spacing: -.02em; transition: color .25s, transform .35s var(--t); }
.casa-servicios .desc { color: var(--tinta-suave); font-size: .9rem; line-height: 1.45; max-width: 30ch; }
.casa-servicios a:hover .nombre { color: var(--azul); transform: translateX(4px); }
.casa-ir { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.casa-ir > span { font: 500 .78rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--tinta-suave); }
.casa-ir ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
.casa-ir button { background: rgba(255, 255, 255, .45); border: 1px solid rgba(29, 27, 24, .18); color: var(--tinta); border-radius: 999px; padding: .5rem .95rem;
  font: 500 .88rem var(--sans); cursor: pointer; min-height: 44px; transition: border-color .2s, background .2s, transform .15s; }
.casa-ir button:hover { border-color: #8a6a4c; background: #fff; } .casa-ir button:active { transform: scale(.97); }

@media (max-width: 860px) {
  .casa-servicios { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 759px) {
  .casa-panel { position: fixed; z-index: 45; left: 0; right: 0; top: auto; bottom: 0; width: auto; max-height: 54vh; border-radius: 18px 18px 0 0; transform: translateY(100%); }
  .casa-panel.abierto { transform: none; }
  .casa-foto { aspect-ratio: 16 / 6; }
  .casa-cuerpo { padding: .9rem 1.2rem .6rem; } .casa-t { font-size: 1.6rem; }
  .casa-svg { max-height: none; }
  .casa-servicios { grid-template-columns: 1fr; }
  .casa-servicios a { padding: 1rem 0; }
}
@media (prefers-reduced-motion: reduce) {
  .casa .room, .casa .etiquetas, .casa-panel, .casa-foto img { animation: none !important; transition: none !important; }
}
</style>
