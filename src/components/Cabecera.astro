---
import { r } from '../lib/sitio.js';
const { portada = false } = Astro.props;
const servicios = [
  ['/cocinas/', 'Cocinas a medida'], ['/armarios/', 'Armarios y vestidores'], ['/muebles-de-bano-a-medida/', 'Muebles de baño'],
  ['/puertas/', 'Puertas de madera'], ['/disenos-3d/', 'Diseños en 3D'], ['/miscelanea/', 'Otros trabajos'], ['/destacado/', 'Todos los trabajos'],
];
const juegos = [['/combina-tu-cocina/', 'Combina tu cocina'], ['/disena-tu-armario/', 'Diseña tu armario o vestidor'], ['/combina-tu-bano/', 'Combina tu baño'], ['/configura-tu-puerta/', 'Configura tu puerta'], ['/disena-tu-salon/', 'Diseña tu salón'], ['/elige-tu-encimera/', 'Elige tu encimera'], ['/que-cocina-va-contigo/', '¿Qué cocina va contigo? (quiz)'], ['/que-armario-va-contigo/', '¿Qué armario va contigo? (quiz)'], ['/mi-proyecto/', 'Mi proyecto']];
const ruta = Astro.url.pathname;
const activo = (p) => ruta.endsWith(p) ? 'page' : undefined;
---
<header class={`cabecera ${portada ? 'sobre-foto' : ''}`} data-cabecera>
  <div class="cabecera-in">
    <a class="logo" href={r('/')} aria-label="Muebles Carrascosa, inicio">
      <img src={r('/img/carrascosa-horizontal-blanco-4096-800.webp')} alt="Carrascosa, madera de diseño" width="176" height="32" />
    </a>
    <button class="tema-boton" type="button" aria-label="Cambiar a modo oscuro" title="Modo claro u oscuro">
      <svg class="t-luna" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"/></svg>
      <svg class="t-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <script is:inline>
      (function () {
        var b = document.currentScript.previousElementSibling, h = document.documentElement;
        var poner = function () { var o = h.dataset.tema === 'oscuro'; b.setAttribute('aria-label', o ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'); };
        poner(); addEventListener('cambio-tema', poner);
        b.addEventListener('click', function () {
          var o = h.dataset.tema !== 'oscuro'; h.dataset.tema = o ? 'oscuro' : 'claro';
          try { localStorage.setItem('tema', o ? 'oscuro' : 'claro'); } catch (e) {}
          var m = document.querySelector('meta[name=theme-color]'); if (m) m.content = o ? '#17140f' : '#f4efe5';
          poner(); dispatchEvent(new Event('cambio-tema'));
        });
      })();
    </script>
    <button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir el menú"><span></span><span></span><span></span></button>
    <nav id="menu" class="menu" aria-label="Principal">
      <ul>
        <li class="desplegable">
          <button type="button" aria-expanded="false">Servicios</button>
          <ul>{servicios.map(([h, t]) => <li><a href={r(h)} aria-current={activo(h)}>{t}</a></li>)}</ul>
        </li>
        <li class="desplegable">
          <button type="button" aria-expanded="false">Juegos</button>
          <ul>{juegos.map(([h, t]) => <li><a href={r(h)} aria-current={activo(h)}>{t}</a></li>)}</ul>
        </li>
        <li><a href={r('/preguntas-frecuentes/')} aria-current={activo('/preguntas-frecuentes/')}>Dudas</a></li>
        <li><a href={r('/entradas-del-blog/')} aria-current={activo('/entradas-del-blog/')}>Blog</a></li>
        <li><a href={r('/donde-trabajamos/')} aria-current={activo('/donde-trabajamos/')}>Zonas</a></li>
        <li><a href={r('/acerca-de/')} aria-current={activo('/acerca-de/')}>Nosotros</a></li>
        <li><a href={r('/contacto/')} aria-current={activo('/contacto/')}>Contacto</a></li>
      </ul>
      <a class="boton" href={r('/contacto/')}>Pide presupuesto</a>
    </nav>
  </div>
</header>
