---
import Base from '../../layouts/Base.astro';
import { r, EMPRESA, HORARIO_SCHEMA } from '../../lib/sitio.js';
import paginas from '../../datos/paginas.json';
const p = paginas.find((x) => x.slug === 'contacto');
const schema = {
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', name: EMPRESA.nombre, telephone: EMPRESA.tel, email: EMPRESA.email,
  address: { '@type': 'PostalAddress', streetAddress: EMPRESA.calle, postalCode: EMPRESA.cp, addressLocality: EMPRESA.pueblo, addressRegion: EMPRESA.provincia, addressCountry: 'ES' },
  openingHoursSpecification: HORARIO_SCHEMA,
};
---
<Base titulo={p?.tituloSeo || 'Contacto y presupuesto'} descripcion={p?.descripcion} schema={schema}>
  <header class="cabeza-pagina ancho" data-entra>
    <span class="etiqueta">Contacto</span>
    <h1>Pide presupuesto sin compromiso</h1>
    <p class="entradilla">¿Tienes en mente una cocina, un armario o cualquier mueble a medida? Cuéntanos qué necesitas. Puedes escribirnos aquí, llamarnos, mandarnos un WhatsApp o pasarte por el taller.</p>
  </header>
  <section class="ancho contacto" style="padding-bottom:clamp(3rem,7vw,5rem)">
    <form id="pide-presupuesto" class="formulario" novalidate>
      <fieldset class="chips">
        <legend>¿Qué necesitas?</legend>
        {['Cocina a medida', 'Armario o vestidor', 'Mueble de baño', 'Puertas', 'Otro mueble'].map((t, i) => <label><input type="radio" name="tipo" value={t} checked={i === 0} /><span>{t}</span></label>)}
      </fieldset>
      <div class="dos">
        <label>Tu nombre<input name="nombre" autocomplete="name" required /></label>
        <label>Teléfono (opcional)<input name="telefono" type="tel" inputmode="tel" autocomplete="tel" /></label>
      </div>
      <label>Pueblo (opcional)<input name="pueblo" autocomplete="address-level2" /></label>
      <label>Cuéntanos tu proyecto<textarea name="mensaje" required placeholder="Medidas aproximadas, colores que te gustan, cuándo lo necesitas…"></textarea></label>
      <label class="fotos-campo">Fotos o plano (opcional)
        <span class="fotos-caja"><input name="fotos" type="file" accept="image/*,application/pdf" multiple /><span class="fotos-texto">📷 Añadir fotos de la cocina, del hueco o del plano</span></span>
        <span class="nota fotos-lista" aria-live="polite"></span>
      </label>
      <div class="botones" style="margin:.5rem 0 0">
        <button class="boton" type="submit" value="whatsapp">Enviar por WhatsApp</button>
        <button class="boton contorno" type="submit" value="correo">Enviar por correo</button>
      </div>
      <div class="fotos-aviso" hidden role="status"><p></p><a class="boton" href="#">Abrir WhatsApp</a></div>
      <p class="nota">Al enviar se abre WhatsApp o tu correo con el mensaje ya escrito; si has elegido fotos, las adjuntas allí con el clip 📎. El presupuesto es sin compromiso y <a href={r('/preguntas-frecuentes/#p-el-precio-puede-cambiar')}>cerrado</a>. Usamos tus datos solo para responderte. <a href={r('/politica-de-privacidad/')}>Política de privacidad</a>.</p>
    </form>
    <aside class="ficha">
      <h2>El taller</h2>
      <p>{EMPRESA.calle}<br />{EMPRESA.cp} {EMPRESA.pueblo} ({EMPRESA.provincia})<br />En la comarca de Las Villas, a los pies de las sierras de Cazorla y Segura.</p>
      <h2>Horario</h2>
      <dl>{EMPRESA.horario.map(([d, h]) => <><dt>{d}</dt><dd>{h}</dd></>)}</dl>
      <div class="botones">
        <a class="boton" href={`tel:${EMPRESA.tel}`}>Llamar al {EMPRESA.telefono}</a>
        <a class="boton contorno" href={EMPRESA.comoLlegar} target="_blank" rel="noopener">Cómo llegar</a>
      </div>
    </aside>
  </section>
  <section class="ancho cita" id="cita" aria-labelledby="titulo-cita">
    <div class="cita-texto">
      <span class="etiqueta">Cita para medir</span>
      <h2 id="titulo-cita" style="font-size:clamp(2rem,4.5vw,3.4rem)">Vamos a tu casa a medir.</h2>
      <p class="suave">Elige el día y la franja que mejor te venga. Te llamamos para confirmarla y, si ese día no podemos, te proponemos otro.</p>
      <p class="suave">La visita y el diseño en 3D cuestan <b>80 €</b>, que te descontamos si nos haces el encargo.</p>
    </div>
    <form class="formulario" id="form-cita" novalidate>
      <div class="dos">
        <label>Día<input type="date" name="dia" required /></label>
        <fieldset class="chips"><legend>Franja</legend>
          <label><input type="radio" name="franja" value="mañana (de 9 a 14 h)" checked /><span>Mañana</span></label>
          <label><input type="radio" name="franja" value="tarde (de 16 a 19 h)" /><span>Tarde</span></label>
        </fieldset>
      </div>
      <p class="nota cita-aviso" aria-live="polite"></p>
      <fieldset class="chips">
        <legend>¿Qué hay que medir?</legend>
        {['Cocina', 'Armario o vestidor', 'Baño', 'Puertas', 'Salón o mueble de TV', 'Otro'].map((t, i) => <label><input type="radio" name="que" value={t} checked={i === 0} /><span>{t}</span></label>)}
      </fieldset>
      <div class="dos">
        <label>Tu nombre<input name="nombre" autocomplete="name" required /></label>
        <label>Teléfono<input name="telefono" type="tel" inputmode="tel" autocomplete="tel" required /></label>
      </div>
      <label>Dirección o pueblo<input name="donde" autocomplete="street-address" required /></label>
      <div class="cita-diseno" hidden><p class="nota"><b>Va con tu diseño:</b> <span></span></p><button class="boton contorno pequeno" type="button">Quitar</button></div>
      <div class="botones" style="margin:.5rem 0 0">
        <button class="boton" type="submit" value="whatsapp">Pedir cita por WhatsApp</button>
        <button class="boton contorno" type="submit" value="correo">Por correo</button>
      </div>
      <p class="nota">Medimos de lunes a viernes. La visita la confirmamos nosotros por teléfono o WhatsApp.</p>
    </form>
  </section>
  <section class="ancho" style="padding-bottom:clamp(4rem,8vw,6rem)" aria-labelledby="titulo-mapa">
    <span class="etiqueta">Dónde estamos</span>
    <h2 id="titulo-mapa" style="font-size:clamp(2rem,4.5vw,3.4rem)">Ven a ver el taller.</h2>
    <p class="suave" style="max-width:56ch">Estamos en {EMPRESA.pueblo}, en la comarca de Las Villas. Trabajamos en toda la provincia de Jaén y, según el encargo, también en Granada, Albacete o Madrid.</p>
    <div class="mapa" data-mapa={`https://www.google.com/maps?q=${encodeURIComponent(`${EMPRESA.nombre}, ${EMPRESA.calle}, ${EMPRESA.cp} ${EMPRESA.pueblo}, ${EMPRESA.provincia}`)}&z=15&output=embed`}>
      <div class="mapa-tapa">
        <span class="pin" aria-hidden="true"></span>
        <p><b>{EMPRESA.calle}</b>{EMPRESA.cp} {EMPRESA.pueblo} ({EMPRESA.provincia})</p>
        <div class="botones" style="margin:.5rem 0 0;justify-content:center">
          <button class="boton" type="button">Ver el mapa</button>
          <a class="boton contorno" href={EMPRESA.comoLlegar} target="_blank" rel="noopener">Cómo llegar</a>
        </div>
        <p style="font-size:.85rem">El mapa es de Google y solo se carga si pulsas «Ver el mapa».</p>
      </div>
    </div>
  </section>
</Base>
