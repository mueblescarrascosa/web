---
// Juego «Combina tu cocina»: el visitante elige distribución, colores y acabados, ve su cocina en perspectiva
// (de día o de noche) y le decimos si combina y por qué. Puede guardar 3 favoritas, descargar la imagen y mandarla al taller.
import Base from '../../layouts/Base.astro';
import { r, EMPRESA } from '../../lib/sitio.js';
import { LISTAS, INICIAL, puntuar, estiloVars } from '../../datos/combina.js';
import { svgCocina, VISTA } from '../../scripts/cocina-dibujo.js';

const L = LISTAS();
const ini = Object.fromEntries(Object.entries(INICIAL).map(([k, v]) => [k, L[k].find((x) => x.clave === v)]));
const nota = puntuar(ini);

// Iconos para lo que no es un color
const ICONOS = {
  lineal: '<rect x="5" y="8" width="30" height="8" rx="1"/>',
  L: '<rect x="5" y="8" width="30" height="8" rx="1"/><rect x="5" y="8" width="8" height="25" rx="1"/>',
  isla: '<rect x="5" y="8" width="30" height="8" rx="1"/><rect x="11" y="24" width="18" height="8" rx="1"/>',
  peninsula: '<rect x="5" y="8" width="30" height="8" rx="1"/><rect x="27" y="8" width="8" height="25" rx="1"/>',
  lisa: '<rect x="11" y="5" width="18" height="30" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="24" y="9" width="2" height="8"/>',
  moldura: '<rect x="11" y="5" width="18" height="30" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="15" y="9" width="10" height="22" fill="none" stroke="currentColor" stroke-width="1.4"/>',
  ranurada: '<rect x="11" y="5" width="18" height="30" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 7v26M19 7v26M23 7v26" stroke="currentColor" stroke-width="1.2"/>',
};
const grupos = [
  { id: 'dist', titulo: 'Distribución', icono: true },
  { id: 'bajos', titulo: 'Muebles bajos' },
  { id: 'altos', titulo: 'Muebles altos y columna' },
  { id: 'puerta', titulo: 'Modelo de puerta', icono: true },
  { id: 'encimera', titulo: 'Encimera' },
  { id: 'tirador', titulo: 'Tiradores' },
  { id: 'trasera', titulo: 'Pared entre muebles' },
  { id: 'electro', titulo: 'Electrodomésticos' },
  { id: 'suelo', titulo: 'Suelo' },
  { id: 'pared', titulo: 'Pared' },
];
const claseMuestra = (g, x) => [g.icono ? 'icono' : '', x.dibujo || '', x.tipo && g.id === 'tirador' ? 't-' + x.tipo : '', g.id === 'trasera' ? 'tr-' + x.tipo : ''].filter(Boolean).join(' ');
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Combina tu cocina', applicationCategory: 'DesignApplication', operatingSystem: 'Navegador web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, provider: { '@type': 'Organization', name: EMPRESA.nombre } };
---
<Base titulo="Combina los colores de tu cocina" descripcion="Juega a combinar tu cocina: distribución, muebles, puertas, encimera, tiradores y suelo, de día y de noche. Te decimos al momento si combina y por qué. Por Muebles Carrascosa, cocinas a medida en Jaén." schema={schema}>
  <header class="cabeza-pagina ancho" data-entra>
    <span class="etiqueta">Juego · Combina tu cocina</span>
    <h1>¿Combinan tus colores?</h1>
    <p class="entradilla">Elige la forma de tu cocina, los muebles, las puertas, la encimera y el suelo. La verás al momento, de día y de noche, y te diremos si combina y por qué, como lo haríamos en el taller.</p>
  </header>

  <section class="ancho combina" id="combina">
    <div class="combina-vista">
      <div class="lienzo">
        <svg class="cocina" viewBox={VISTA} role="img" aria-label="Dibujo de la cocina con lo elegido" style={estiloVars(ini)} data-tirador={ini.tirador.tipo} data-luz="dia" data-dibujo={`${INICIAL.dist}|${INICIAL.puerta}`} set:html={svgCocina({ dist: INICIAL.dist, puerta: INICIAL.puerta })} />
        <button class="boton-luz" type="button" aria-pressed="false" aria-label="Ver la cocina de noche, con las luces encendidas">
          <svg class="sol" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <svg class="luna" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor" /></svg>
          <span>Noche</span>
        </button>
      </div>

      <div class="nota" aria-live="polite">
        <div class="anillo">
          <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="42" class="pista-anillo" /><circle cx="50" cy="50" r="42" class="valor" style={`stroke-dashoffset:${263.9 * (1 - nota.puntos / 100)}`} /></svg>
          <b class="puntos">{nota.puntos}</b>
        </div>
        <div>
          <p class="veredicto">{nota.veredicto}</p>
          <p class="estilo">Estilo <span>{nota.estilo}</span></p>
        </div>
      </div>
      <ul class="motivos">
        {nota.bien.map((t) => <li class="bien">{t}</li>)}{nota.ojo.map((t) => <li class="ojo">{t}</li>)}
      </ul>
    </div>

    <div class="combina-mandos">
      {grupos.map((g) => (
        <fieldset class="muestras" data-grupo={g.id}>
          <legend>{g.titulo} <span class="elegido">{ini[g.id].nombre}</span></legend>
          <div class={`lista-muestras${g.icono ? ' con-iconos' : ''}`}>
            {L[g.id].map((x) => (
              <label title={x.nombre}>
                <input type="radio" name={g.id} value={x.clave} checked={ini[g.id].clave === x.clave} />
                {g.icono
                  ? <span class={`muestra ${claseMuestra(g, x)}`}><svg viewBox="0 0 40 40" aria-hidden="true" set:html={ICONOS[x.clave]} /></span>
                  : <span class={`muestra ${claseMuestra(g, x)}`} style={x.hex ? `--c:${x.hex}` : undefined}></span>}
                <span class={g.icono ? 'texto-muestra' : 'nombre-muestra'}>{x.nombre}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="botones combina-botones">
        <button class="boton contorno" type="button" data-accion="inspirame">✦ Inspírame</button>
        <button class="boton contorno" type="button" data-accion="guardar">♡ Guardar</button>
        <button class="boton contorno" type="button" data-accion="descargar">Descargar imagen</button>
        <button class="boton contorno" type="button" data-accion="compartir">Compartir enlace</button>
        <a class="boton" data-accion="whatsapp" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Mándasela al taller</a>
      </div>
      <p class="aviso-colores">Los colores son orientativos: la pantalla no reproduce bien la madera ni las texturas. En el taller te enseñamos las muestras reales.</p>
    </div>
  </section>

  <section class="ancho favoritas" id="favoritas" hidden>
    <div class="favoritas-cabeza">
      <h2>Tus cocinas</h2>
      <p class="suave">Guarda hasta 3 y compáralas. Se quedan en este navegador.</p>
    </div>
    <div class="favoritas-lista"></div>
  </section>

  <article class="contenido consejos-color">
    <h2>Cómo combinar los colores de la cocina</h2>
    <p>Lo que solemos explicar en el taller cuando alguien duda entre dos colores:</p>
    <h3>1. Claro arriba, más oscuro abajo</h3>
    <p>Los muebles altos claros y los bajos más oscuros hacen que la cocina parezca más alta y más amplia. Al revés, los altos oscuros «se te echan encima», sobre todo en cocinas pequeñas.</p>
    <h3>2. La encimera tiene que contrastar</h3>
    <p>Si la encimera es del mismo tono que los muebles bajos, la cocina se ve plana. Una encimera clara con bajos oscuros (o al revés) marca la zona de trabajo y da profundidad. Y si la subes a la pared entre los muebles, la cocina gana continuidad y se limpia mejor.</p>
    <h3>3. Una sola madera</h3>
    <p>Dos maderas parecidas pero distintas compiten entre sí. Elige una y repítela, o combina dos muy diferentes, como roble claro con nogal. Ojo también con el suelo: unos bajos del mismo tono que la tarima se pierden.</p>
    <h3>4. Un solo color con carácter</h3>
    <p>Verde salvia, azul marino o terracota lucen mucho si van solos y acompañados de blanco, crema o madera. Dos colores fuertes a la vez cansan pronto; tampoco conviene juntar muebles de color con un azulejo de color.</p>
    <h3>5. Puertas y tiradores van de la mano</h3>
    <p>El negro va con todo. El oro y el bronce lucen sobre verdes, azules, cremas y negro, sobre todo con puertas de moldura, que piden tirador. La gola o el uñero, sin tiradores a la vista, son para puertas lisas. Y las puertas ranuradas en madera dan un aire japandi muy actual.</p>
    <p>¿Quieres verlo con tus medidas? <a href={r('/disenos-3d/')}>Te diseñamos la cocina en 3D</a> con los colores que elijas antes de fabricarla, y puedes ver <a href={r('/cocinas/')}>cocinas que ya hemos hecho</a>. ¿Dudas con las medidas? <a href={r('/preguntas-frecuentes/')}>Pregúntanos</a>.</p>
  </article>

  <section class="seccion claro cierre">
    <div class="ancho">
      <span class="etiqueta">¿Te gusta tu combinación?</span><br />
      <a class="frase" href={r('/contacto/')}>Hablemos <span aria-hidden="true">→</span></a>
      <div class="botones"><a class="boton" href={r('/contacto/')}>Pide presupuesto</a><a class="boton contorno" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Escríbenos por WhatsApp</a></div>
    </div>
  </section>

  <script>
    import { LISTAS, INICIAL, PROPUESTAS, puntuar, variables, estiloVars } from '../../datos/combina.js';
    import { svgCocina, VISTA } from '../../scripts/cocina-dibujo.js';
    const listas = LISTAS();
    const $ = (s, c = document) => c.querySelector(s), $$ = (s, c = document) => [...c.querySelectorAll(s)];
    const svg = $('svg.cocina'), raiz = $('#combina');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CLAVE = 'combina_favoritas_v1';
    let estado = { ...INICIAL }, mostrado = null, noche = false;

    const deEnlace = () => { const p = new URLSearchParams(location.hash.slice(1)); Object.keys(listas).forEach((k) => { if (listas[k].some((x) => x.clave === p.get(k))) estado[k] = p.get(k); }); if (p.get('luz') === 'noche') noche = true; };
    const aEnlace = () => history.replaceState(null, '', '#' + new URLSearchParams({ ...estado, ...(noche ? { luz: 'noche' } : {}) }).toString());
    const elegidos = (e = estado) => Object.fromEntries(Object.entries(e).filter(([k]) => listas[k]).map(([k, v]) => [k, listas[k].find((x) => x.clave === v) || listas[k].find((x) => x.clave === INICIAL[k])]));
    const resumen = (e) => `${e.dist.nombre} · Bajos: ${e.bajos.nombre} · Altos: ${e.altos.nombre} · Puertas: ${e.puerta.nombre.toLowerCase()} · Encimera: ${e.encimera.nombre} · Tiradores: ${e.tirador.nombre} · Pared: ${e.trasera.nombre.toLowerCase()} · Electrodomésticos: ${e.electro.nombre.toLowerCase()} · Suelo: ${e.suelo.nombre}`;

    const contar = (el, de, a) => {
      if (quieto || de == null) { el.textContent = a; return; }
      const t0 = performance.now(), d = 700;
      const paso = (t) => { const p = Math.min(1, (t - t0) / d); el.textContent = Math.round(de + (a - de) * (1 - (1 - p) ** 3)); if (p < 1) requestAnimationFrame(paso); };
      requestAnimationFrame(paso);
    };

    function pintar(animar = true) {
      const e = elegidos();
      // La forma solo se vuelve a dibujar si cambia la distribución o la puerta; los colores cambian con fundido
      const clave = `${estado.dist}|${estado.puerta}`;
      if (svg.dataset.dibujo !== clave) {
        svg.innerHTML = svgCocina({ dist: estado.dist, puerta: estado.puerta }); svg.dataset.dibujo = clave;
        if (!quieto) { svg.classList.remove('redibujo'); void svg.getBoundingClientRect(); svg.classList.add('redibujo'); }
      }
      Object.entries(variables(e)).forEach(([k, v]) => svg.style.setProperty(k, v));
      svg.dataset.tirador = e.tirador.tipo; svg.dataset.luz = noche ? 'noche' : 'dia';
      const bl = $('.boton-luz'); bl.setAttribute('aria-pressed', String(noche)); $('span', bl).textContent = noche ? 'Día' : 'Noche';
      $$('fieldset[data-grupo]').forEach((f) => { const k = f.dataset.grupo; $('.elegido', f).textContent = e[k].nombre; const i = $(`input[value="${estado[k]}"]`, f); if (i) i.checked = true; });

      const n = puntuar(e);
      contar($('.puntos'), mostrado, n.puntos); mostrado = n.puntos;
      $('.anillo .valor').style.strokeDashoffset = 263.9 * (1 - n.puntos / 100);
      $('.anillo').dataset.nivel = n.puntos >= 90 ? 'top' : n.puntos >= 78 ? 'alto' : n.puntos >= 64 ? 'medio' : 'bajo';
      $('.veredicto').textContent = n.veredicto; $('.estilo span').textContent = n.estilo;
      $('.motivos').innerHTML = [...n.bien.map((t) => `<li class="bien">${t}</li>`), ...n.ojo.map((t) => `<li class="ojo">${t}</li>`)].join('');
      if (animar && !quieto) { raiz.classList.remove('cambio'); void raiz.offsetWidth; raiz.classList.add('cambio'); }
      $('[data-accion="whatsapp"]').href = 'https://wa.me/34653451270?text=' + encodeURIComponent(`Hola, he combinado mi cocina en vuestra web y me gusta así:\n${resumen(e)}\n(${n.puntos}/100, estilo ${n.estilo})\n${location.href}`);
      return n;
    }

    raiz.addEventListener('change', (ev) => { const i = ev.target; if (i.type !== 'radio' || !listas[i.name]) return; estado[i.name] = i.value; aEnlace(); pintar(); });
    $('.boton-luz').addEventListener('click', () => { noche = !noche; aEnlace(); pintar(false); });

    // Inspírame: la cocina se monta pieza a pieza
    let ultima = -1;
    $('[data-accion="inspirame"]').addEventListener('click', () => {
      let n; do { n = Math.floor(Math.random() * PROPUESTAS.length); } while (n === ultima && PROPUESTAS.length > 1); ultima = n;
      const { nombre, ...destino } = PROPUESTAS[n];
      const orden = ['dist', 'pared', 'suelo', 'bajos', 'puerta', 'encimera', 'trasera', 'altos', 'electro', 'tirador'];
      if (quieto) { estado = { ...estado, ...destino }; aEnlace(); pintar(); return; }
      orden.forEach((k, i) => setTimeout(() => { estado[k] = destino[k]; const fin = i === orden.length - 1; if (fin) aEnlace(); pintar(fin); }, i * 140));
      const b = $('[data-accion="inspirame"]'); b.textContent = '✦ ' + nombre; setTimeout(() => (b.textContent = '✦ Inspírame'), 2400);
    });

    // Compartir el enlace
    $('[data-accion="compartir"]').addEventListener('click', async (ev) => {
      const b = ev.currentTarget, url = location.href;
      try { if (navigator.share) await navigator.share({ title: 'Mi cocina', text: 'Mira cómo he combinado mi cocina', url }); else { await navigator.clipboard.writeText(url); avisar(b, 'Enlace copiado ✓', 'Compartir enlace'); } } catch (e) {}
    });
    const avisar = (b, t, original) => { b.textContent = t; setTimeout(() => (b.textContent = original), 2000); };

    // ── Favoritas: hasta 3, en este navegador ──
    const leer = () => { try { return JSON.parse(localStorage.getItem(CLAVE) || '[]'); } catch (e) { return []; } };
    const escribir = (l) => { try { localStorage.setItem(CLAVE, JSON.stringify(l)); } catch (e) {} };
    function favoritas() {
      const l = leer(), caja = $('#favoritas');
      caja.hidden = !l.length;
      $('.favoritas-lista', caja).innerHTML = l.map((f, i) => {
        const e = elegidos(f.estado), n = puntuar(e);
        return `<article class="favorita">
          <svg class="cocina mini" viewBox="${VISTA}" style="${estiloVars(e)}" data-tirador="${e.tirador.tipo}" data-luz="${f.noche ? 'noche' : 'dia'}" aria-hidden="true">${svgCocina({ dist: f.estado.dist, puerta: f.estado.puerta })}</svg>
          <div class="favorita-datos"><b>${n.puntos}</b><div><p class="veredicto-mini">${n.veredicto}</p><p class="suave">${e.dist.nombre} · ${e.bajos.nombre} y ${e.altos.nombre.toLowerCase()} · ${e.encimera.nombre}</p></div></div>
          <div class="favorita-botones"><button class="boton contorno" type="button" data-ver="${i}">Ver</button><button class="boton contorno" type="button" data-quitar="${i}" aria-label="Quitar esta cocina">Quitar</button></div>
        </article>`;
      }).join('');
    }
    $('[data-accion="guardar"]').addEventListener('click', (ev) => {
      const l = leer().filter((f) => JSON.stringify(f.estado) !== JSON.stringify(estado));
      l.unshift({ estado: { ...estado }, noche }); escribir(l.slice(0, 3)); favoritas();
      avisar(ev.currentTarget, l.length > 3 ? 'Guardada ✓ (quité la más antigua)' : 'Guardada ✓', '♡ Guardar');
      const primera = $('.favorita'); if (primera && !quieto) primera.animate([{ transform: 'scale(.94)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 500, easing: 'cubic-bezier(.2,.75,.2,1)' });
    });
    $('#favoritas').addEventListener('click', (ev) => {
      const ver = ev.target.closest('[data-ver]'), quitar = ev.target.closest('[data-quitar]'), l = leer();
      if (ver) { const f = l[+ver.dataset.ver]; estado = { ...INICIAL, ...f.estado }; noche = !!f.noche; aEnlace(); pintar(); raiz.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth', block: 'start' }); }
      if (quitar) { l.splice(+quitar.dataset.quitar, 1); escribir(l); favoritas(); }
    });

    // ── Descargar la imagen (en el móvil se comparte directamente) ──
    async function imagen() {
      // Si algún color aún está en pleno fundido, se termina antes de copiar
      try { svg.getAnimations({ subtree: true }).forEach((an) => an.finish()); } catch (er) {}
      const copia = svg.cloneNode(true), a = [svg, ...svg.querySelectorAll('*')], b = [copia, ...copia.querySelectorAll('*')];
      a.forEach((el, i) => {
        const cs = getComputedStyle(el), d = b[i];
        ['display', 'opacity', 'mix-blend-mode'].forEach((p) => d.style.setProperty(p, cs.getPropertyValue(p)));
        ['fill', 'stroke'].forEach((p) => { const v = cs.getPropertyValue(p); if (v && !v.startsWith('url(')) { if (el.style.getPropertyValue(p)) d.style.setProperty(p, v); } });
        d.style.removeProperty('transition'); d.style.removeProperty('animation');
      });
      const AN = 2000, AL = 1020, PIE = 245;
      copia.setAttribute('viewBox', VISTA); copia.setAttribute('xmlns', 'http://www.w3.org/2000/svg'); copia.setAttribute('width', AN); copia.setAttribute('height', AL);
      const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(copia)], { type: 'image/svg+xml' }));
      const img = new Image(); img.src = url; await img.decode(); URL.revokeObjectURL(url);
      const c = document.createElement('canvas'); c.width = AN; c.height = AL + PIE; const x = c.getContext('2d');
      x.drawImage(img, 0, 0, AN, AL);
      x.fillStyle = '#0d0d0e'; x.fillRect(0, AL, AN, PIE);
      const e = elegidos(), n = puntuar(e);
      try { await document.fonts.load('650 52px "Bricolage Grotesque Variable"'); await document.fonts.load('400 26px "Inter Variable"'); } catch (er) {}
      x.fillStyle = '#ffffff'; x.font = '650 52px "Bricolage Grotesque Variable", sans-serif'; x.fillText(`Mi cocina · ${n.puntos}/100 · estilo ${n.estilo}`, 60, AL + 78);
      x.fillStyle = '#a8a39b'; x.font = '400 25px "Inter Variable", sans-serif';
      // El resumen, en dos líneas como mucho
      const lineas = [''];
      resumen(e).split(' · ').forEach((t) => { const l = lineas.length - 1, prueba = lineas[l] ? lineas[l] + ' · ' + t : t; if (x.measureText(prueba).width > AN - 120 && lineas[l]) lineas.push(t); else lineas[l] = prueba; });
      lineas.slice(0, 2).forEach((t, i) => x.fillText(t, 60, AL + 122 + i * 36));
      x.fillStyle = '#c9a27a'; x.fillText('Combina la tuya en mueblescarrascosa.com · Muebles Carrascosa, Villanueva del Arzobispo (Jaén)', 60, AL + 210);
      return new Promise((res) => c.toBlob(res, 'image/png'));
    }
    $('[data-accion="descargar"]').addEventListener('click', async (ev) => {
      const b = ev.currentTarget; b.textContent = 'Preparando…';
      try {
        const blob = await imagen(), archivo = new File([blob], 'mi-cocina-carrascosa.png', { type: 'image/png' });
        if (matchMedia('(pointer: coarse)').matches && navigator.canShare?.({ files: [archivo] })) await navigator.share({ files: [archivo], title: 'Mi cocina' });
        else { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = archivo.name; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 4000); }
        avisar(b, 'Imagen lista ✓', 'Descargar imagen');
      } catch (er) { avisar(b, 'No se pudo crear la imagen', 'Descargar imagen'); }
    });

    // En el móvil, el dibujo y la nota se quedan fijos arriba y los motivos bajan junto a los botones
    const mq = matchMedia('(max-width: 900px)'), motivos = $('.motivos');
    const colocar = () => (mq.matches ? $('.combina-botones').before(motivos) : $('.combina-vista').append(motivos));
    // En el móvil el dibujo se recorta un poco por los lados para que la cocina se vea más grande
    const encuadre = () => svg.setAttribute('viewBox', mq.matches ? '60 120 880 490' : VISTA);
    mq.addEventListener('change', () => { colocar(); encuadre(); }); colocar(); encuadre();

    deEnlace(); pintar(false); favoritas();
  </script>
</Base>
