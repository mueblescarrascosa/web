---
import Base from '../layouts/Base.astro';
import { r, peq, EMPRESA, entradasVisibles } from '../lib/sitio.js';
import medios from '../datos/medios.json';

const f = (id) => medios[id] || { src: '', alt: '' };
const servicios = [
  [559, '/cocinas/', 'Cocinas a medida', 'Pensadas para tu espacio y tu forma de cocinar, con los materiales y la encimera que elijas.'],
  [536, '/armarios/', 'Armarios y vestidores', 'Empotrados, abuhardillados y vestidores que aprovechan cada centímetro.'],
  [1619, '/muebles-de-bano-a-medida/', 'Muebles de baño', 'A la medida exacta del hueco y con materiales que aguantan la humedad.'],
  [542, '/puertas/', 'Puertas de madera', 'Puertas de paso y de entrada fabricadas y restauradas en el taller.'],
];
const trabajos = [620, 608, 611, 572, 589, 587];
const guias = entradasVisibles().slice(0, 3);
const schema = {
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', name: EMPRESA.nombre, url: 'https://mueblescarrascosa.com/',
  telephone: EMPRESA.tel, email: EMPRESA.email, foundingDate: '1969', image: 'https://mueblescarrascosa.com/img/imagen-de-whatsapp-2024-01-12-a-las-11.55.13-b35fe81d.webp',
  address: { '@type': 'PostalAddress', streetAddress: EMPRESA.calle, postalCode: EMPRESA.cp, addressLocality: EMPRESA.pueblo, addressRegion: EMPRESA.provincia, addressCountry: 'ES' },
  sameAs: [EMPRESA.facebook, EMPRESA.instagram],
};
---
<Base titulo="Muebles Carrascosa · Cocinas, armarios y vestidores a medida en Jaén" descripcion="Carpintería familiar en Villanueva del Arzobispo desde 1969. Diseñamos, fabricamos y montamos cocinas, armarios, vestidores y muebles de baño a medida en Jaén." portada schema={schema}>
  <section class="heroe">
    <img src={r(f(618).src)} alt={f(618).alt} fetchpriority="high" width="1600" height="1200" />
    <div class="ancho heroe-in" data-entra>
      <span class="dato">Taller propio en Villanueva del Arzobispo · desde 1969</span>
      <h1>Cocinas, armarios y vestidores a medida en&nbsp;Jaén</h1>
      <p>Los diseñamos contigo, los fabricamos en nuestro taller y los montamos en tu casa. Tres generaciones de carpinteros.</p>
      <div class="botones">
        <a class="boton" href={r('/contacto/')}>Pide presupuesto</a>
        <a class="boton contorno" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="seccion" id="servicios">
    <div class="ancho">
      <span class="antetitulo">Lo que hacemos</span>
      <h2>Muebles a medida, del plano a tu casa</h2>
      <div class="rejilla cuatro" style="margin-top:2.5rem">
        {servicios.map(([id, h, t, d]) => (
          <a class="tarjeta" href={r(h)}>
            <div class="foto"><img src={r(peq(f(id).src))} alt={f(id).alt} loading="lazy" width="800" height="600" /></div>
            <h3><span>{t}</span></h3>
            <p>{d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion piedra">
    <div class="ancho">
      <span class="antetitulo">Cómo trabajamos</span>
      <h2>Cuatro pasos y un solo taller</h2>
      <ol class="pasos">
        <li><h3>Visita y medición</h3><p>Vamos a tu casa, tomamos medidas y vemos contigo qué necesitas.</p></li>
        <li><h3>Diseño en 3D</h3><p>Te enseñamos cómo quedará, con colores y materiales, antes de fabricar nada. <a class="enlace-flecha" href={r('/disenos-3d/')}>Ver diseños</a></p></li>
        <li><h3>Fabricación en el taller</h3><p>Lo fabricamos nosotros en Villanueva del Arzobispo, pieza a pieza.</p></li>
        <li><h3>Montaje</h3><p>Lo montamos nosotros y lo dejamos terminado y limpio.</p></li>
      </ol>
    </div>
  </section>

  <section class="seccion">
    <div class="ancho">
      <span class="antetitulo">Trabajos</span>
      <h2>Algunas cocinas, armarios y vestidores</h2>
      <div class="mosaico" style="margin-top:2.5rem">
        {trabajos.map((id) => <a href={r(f(id).src)}><img src={r(peq(f(id).src))} alt={f(id).alt} loading="lazy" /></a>)}
      </div>
      <p style="margin-top:1.5rem"><a class="enlace-flecha" href={r('/destacado/')}>Ver todos nuestros trabajos →</a></p>
    </div>
  </section>

  <section class="seccion piedra">
    <div class="ancho historia">
      <div>
        <p class="anio" aria-hidden="true">1969</p>
        <h2>Tres generaciones en el mismo taller</h2>
        <p>Lo que mi abuelo empezó como un pequeño taller de carpintería en Villanueva del Arzobispo es hoy un negocio familiar de tres generaciones. Diseñamos, fabricamos e instalamos cocinas, armarios y vestidores hechos a tu medida, ni de catálogo ni en serie.</p>
        <p><a class="enlace-flecha" href={r('/acerca-de/')}>Conoce nuestra historia →</a></p>
      </div>
      <img src={r(peq(f(1216).src))} alt={f(1216).alt} loading="lazy" width="800" height="600" />
    </div>
  </section>

  <section class="seccion">
    <div class="ancho">
      <span class="antetitulo">Opiniones en Google · 5,0</span>
      <h2>Lo que dicen nuestros clientes</h2>
      <div class="resenas">
        <blockquote><span class="estrellas" aria-label="5 estrellas">★★★★★</span>«Un trato profesional excepcional. Son una empresa familiar y de confianza. ¡Sin duda contaremos con ellos para futuros trabajos!»<cite>María Á.</cite></blockquote>
        <blockquote><span class="estrellas" aria-label="5 estrellas">★★★★★</span>«Una empresa formal, profesional y que cuida el detalle. Muy recomendable.»<cite>Dávila</cite></blockquote>
        <blockquote><span class="estrellas" aria-label="5 estrellas">★★★★★</span>«Muy buena experiencia. Muy profesionales, rápidos y buen trato.»<cite>Rosa M.</cite></blockquote>
      </div>
      <p style="margin-top:2rem"><a class="enlace-flecha" href={EMPRESA.verResenas} target="_blank" rel="noopener">Ver todas las reseñas en Google →</a></p>
    </div>
  </section>

  {guias.length > 0 && (
    <section class="seccion piedra">
      <div class="ancho">
        <span class="antetitulo">Guías</span>
        <h2>Antes de decidirte, léete esto</h2>
        <div class="rejilla tres" style="margin-top:2.5rem">
          {guias.map((e) => (
            <a class="tarjeta" href={r(e.ruta)}>
              {e.portada && <div class="foto"><img src={r(peq(e.portada.src))} alt={e.portada.alt} loading="lazy" width="800" height="600" /></div>}
              <h3><span>{e.titulo}</span></h3>
            </a>
          ))}
        </div>
        <p style="margin-top:2rem"><a class="enlace-flecha" href={r('/entradas-del-blog/')}>Ver todas las guías →</a></p>
      </div>
    </section>
  )}

  <section class="seccion azul">
    <div class="ancho cierre">
      <div>
        <h2>¿Tienes un proyecto en mente?</h2>
        <p>Cuéntanos qué necesitas y te preparamos el presupuesto. También puedes llamarnos al <a href={`tel:${EMPRESA.tel}`}>{EMPRESA.telefono}</a> o pasarte por el taller.</p>
      </div>
      <div class="botones" style="margin:0">
        <a class="boton blanco" href={r('/contacto/')}>Pide presupuesto</a>
        <a class="boton contorno" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
