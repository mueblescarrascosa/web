---
import Base from '../layouts/Base.astro';
import Casa from '../components/Casa.astro';
import { r, peq, EMPRESA, HORARIO_SCHEMA, ZONA, entradasVisibles } from '../lib/sitio.js';
import medios from '../datos/medios.json';

const f = (id) => medios[id] || { src: '', alt: '' };
const servicios = [
  [559, '/cocinas/', 'Cocinas', 'A tu espacio y tu forma de cocinar, con la encimera que elijas.'],
  [536, '/armarios/', 'Armarios y vestidores', 'Empotrados, abuhardillados y vestidores que aprovechan cada centímetro.'],
  [1619, '/muebles-de-bano-a-medida/', 'Baños', 'A la medida exacta del hueco y con materiales que aguantan la humedad.'],
  [542, '/puertas/', 'Puertas', 'De paso y de entrada, fabricadas y restauradas en el taller.'],
];
// Paso 01 sin foto hasta tener una propia de medir (nada de fotos de banco). La del 03 es la fachada real del taller, recortada para que no salga el teléfono antiguo del rótulo.
const fotoDe = (x) => (typeof x === 'object' ? x : f(x));
const pasos = [
  ['01', 'Vamos a tu casa y medimos', 'Tomamos las medidas reales y vemos contigo cómo vives el espacio: qué guardas, cómo cocinas, qué te sobra y qué te falta.', null],
  ['02', 'Lo ves en 3D antes de fabricar', 'Te enseñamos cómo quedará, con sus colores y materiales, y lo cambiamos las veces que haga falta.', 1679],
  ['03', 'Lo fabricamos en nuestro taller', 'Pieza a pieza, en Villanueva del Arzobispo. Nada de catálogo ni de muebles en serie.', { src: '/img/taller-fachada.webp', alt: 'Entrada del taller de Muebles Carrascosa en la calle Fuenclara, Villanueva del Arzobispo' }],
  ['04', 'Lo montamos y lo dejamos limpio', 'Nuestro propio equipo lo instala, lo ajusta y no se va hasta que está terminado.', 618],
];
const trabajos = [620, 609, 608, 536, 611, 589, 606, 572, 587, 588];
const guias = entradasVisibles().slice(0, 3);
const schema = {
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', name: EMPRESA.nombre, url: 'https://mueblescarrascosa.com/',
  telephone: EMPRESA.tel, email: EMPRESA.email, foundingDate: '1969',
  address: { '@type': 'PostalAddress', streetAddress: EMPRESA.calle, postalCode: EMPRESA.cp, addressLocality: EMPRESA.pueblo, addressRegion: EMPRESA.provincia, addressCountry: 'ES' },
  logo: 'https://mueblescarrascosa.com/logo-negro.png',
  image: 'https://mueblescarrascosa.com/img/compartir-portada.jpg',
  openingHoursSpecification: HORARIO_SCHEMA,
  areaServed: ZONA.map((name) => ({ '@type': 'City', name })),
  // Coordenadas de la ficha de Google Maps del taller (23/11/2026)
  geo: { '@type': 'GeoCoordinates', latitude: 38.1648448, longitude: -3.0053067 },
  hasMap: 'https://maps.google.com/?cid=18253800201549540277',
  description: 'Carpintería familiar en Villanueva del Arzobispo (Jaén) desde 1969. Diseñamos en 3D, fabricamos en nuestro taller y montamos cocinas, armarios empotrados, vestidores, muebles de baño, puertas y suelos de madera a medida.',
  priceRange: '€€',
  knowsAbout: ['Cocinas a medida', 'Armarios empotrados', 'Vestidores', 'Muebles de baño', 'Puertas de madera', 'Suelos de madera', 'Carpintería a medida'],
  sameAs: [EMPRESA.facebook, EMPRESA.instagram, 'https://maps.google.com/?cid=18253800201549540277'],
};
---
<Base titulo="Muebles Carrascosa · Cocinas, armarios y vestidores a medida en Jaén" descripcion="Carpintería familiar en Villanueva del Arzobispo desde 1969. Diseñamos, fabricamos y montamos cocinas, armarios, vestidores y muebles de baño a medida en Jaén." portada schema={schema}>
  <section class="heroe">
    <div class="heroe-texto" data-entra>
      <span class="etiqueta">Carpintería en Jaén · desde 1969</span>
      <h1>Madera a tu <em>medida.</em></h1>
      <p class="entradilla">Cocinas, armarios, vestidores y baños que diseñamos contigo, fabricamos en nuestro taller de Villanueva del Arzobispo y montamos en tu casa.</p>
      <div class="botones">
        <a class="boton" href={r('/contacto/')}>Pide presupuesto <span class="flecha" aria-hidden="true">→</span></a>
        <a class="boton contorno" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      </div>
      <div class="datos-heroe">
        <span><b>3</b>generaciones</span>
        <span><b>5,0 ★</b>en Google</span>
        <span><b>100 %</b>taller propio</span>
      </div>
    </div>
    <div class="heroe-foto">
      <img src={r('/img/cocina-isla-porcelanico-negro-portada.webp')} srcset={`${r('/img/cocina-isla-porcelanico-negro-portada-800.webp')} 800w, ${r('/img/cocina-isla-porcelanico-negro-portada.webp')} 1056w`} sizes="(max-width: 860px) 100vw, 50vw" alt={f(618).alt} fetchpriority="high" width="1056" height="1200" />
      <span class="heroe-sello"><b>1969</b>Villanueva del Arzobispo, Jaén</span>
    </div>
  </section>

  <Casa servicios={servicios.map(([, h, t, d]) => [h, t, d])} />

  <section class="escena-3d" aria-label="Del diseño en 3D a la cocina terminada">
    <div class="escena-3d-in">
      <div class="marco">
        <img class="render" src={r(f(1679).src)} alt="Diseño en 3D de una cocina negra con isla" loading="lazy" width="1600" height="1130" />
        <img class="real" src={r(f(559).src)} alt={f(559).alt} loading="lazy" width="1600" height="1200" />
        <span class="linea-corte" aria-hidden="true"></span>
        <span class="rotulo rotulo-3d">Así la diseñamos</span>
        <span class="rotulo rotulo-real">Así quedó</span>
        <input type="range" min="0" max="100" value="50" aria-label="Desliza para comparar el diseño en 3D con la cocina terminada" />
      </div>
      <div class="escena-3d-texto">
        <span class="etiqueta">Del 3D a tu casa</span>
        <h2>Lo que ves es lo que montamos.</h2>
        <p class="suave">Antes de cortar una sola tabla, ves tu cocina en 3D con sus colores y materiales. Luego la fabricamos tal cual. Desliza la foto para compararlas.</p>
        <a class="enlace" href={r('/disenos-3d/')}>Ver más diseños en 3D</a>
      </div>
    </div>
  </section>

  <section class="seccion claro">
    <div class="ancho proceso">
      <div class="proceso-fijo">
        <span class="etiqueta">Cómo trabajamos</span>
        <h2>De tu casa al taller, y vuelta.</h2>
        <p class="suave">Cuatro pasos, un solo equipo. Sabes en todo momento cómo va tu encargo.</p>
        <p class="grande" aria-hidden="true">01</p>
      </div>
      <ol class="pasos">
        {pasos.map(([n, t, d, foto]) => (
          <li class="paso" data-n={n}>
            <span class="etiqueta">Paso {n}</span>
            <h3>{t}</h3>
            <p>{d}{n === '02' && <> <a class="enlace" href={r('/disenos-3d/')}>Ver diseños en 3D</a></>}</p>
            {foto && <img src={r(peq(fotoDe(foto).src))} alt={fotoDe(foto).alt} loading="lazy" width="800" height="500" />}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="escena-pelicula" aria-label="Trabajos">
    <div class="pelicula-cabeza ancho">
      <div>
        <span class="etiqueta">Trabajos</span>
        <h2>Hecho en el taller.<br /><span class="suave">Cocinas y armarios a medida en Jaén.</span></h2>
      </div>
      <a class="enlace" href={r('/destacado/')}>Ver todos los trabajos</a>
    </div>
    <div class="pista">
      {trabajos.map((id, i) => (
        <figure class="fotograma">
          <a href={r(f(id).src)}><img src={r(peq(f(id).src))} alt={f(id).alt} loading="lazy" width="800" height={Math.round((800 * f(id).alto) / f(id).ancho)} /></a>
          <figcaption><span>{String(i + 1).padStart(2, '0')}</span>{f(id).alt}</figcaption>
        </figure>
      ))}
    </div>
      </section>

  <section class="seccion claro" style="overflow:hidden">
    <p class="anio-gigante" aria-hidden="true">1969</p>
    <div class="ancho historia">
      <img src={r(peq(f(1216).src))} alt={f(1216).alt} loading="lazy" width="800" height="600" />
      <div>
        <span class="etiqueta">Nuestra historia</span>
        <h2>Tres generaciones en el mismo taller.</h2>
        <p>Lo que mi abuelo empezó como un pequeño taller de carpintería en Villanueva del Arzobispo es hoy un negocio familiar de tres generaciones. Seguimos haciendo lo mismo que entonces: muebles a medida, uno a uno, para cada casa.</p>
        <p><a class="enlace" href={r('/acerca-de/')}>Conoce nuestra historia</a></p>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="ancho">
      <div class="nota-google"><b>5,0</b><div><span class="etiqueta" style="margin:0 0 .4rem">Opiniones en Google</span><p class="suave" style="margin:0">{EMPRESA.numResenas} reseñas. Lo que dicen quienes ya tienen sus muebles.</p></div></div>
      <div class="resenas">
        <figure class="resena" style="margin:0"><span class="estrellas" aria-label="5 estrellas">★★★★★</span><blockquote>«Un trato profesional excepcional. Son una empresa familiar y de confianza. ¡Sin duda contaremos con ellos para futuros trabajos!»</blockquote><cite>María Á.</cite></figure>
        <figure class="resena" style="margin:0"><span class="estrellas" aria-label="5 estrellas">★★★★★</span><blockquote>«Una empresa formal, profesional y que cuida el detalle. Muy recomendable.»</blockquote><cite>Dávila</cite></figure>
        <figure class="resena" style="margin:0"><span class="estrellas" aria-label="5 estrellas">★★★★★</span><blockquote>«Muy buena experiencia. Muy profesionales, rápidos y buen trato.»</blockquote><cite>Rosa M.</cite></figure>
      </div>
      <p style="margin-top:2rem"><a class="enlace" href={EMPRESA.verResenas} target="_blank" rel="noopener">Ver todas las reseñas en Google</a> · <a class="enlace" href={EMPRESA.escribirResena} target="_blank" rel="noopener">¿Ya tienes tus muebles? Déjanos la tuya</a></p>
    </div>
  </section>

  {guias.length > 0 && (
    <section class="seccion claro">
      <div class="ancho">
        <span class="etiqueta">Guías</span>
        <h2>Antes de decidirte.</h2>
        <div class="rejilla" style="margin-top:3rem">
          {guias.map((e) => (
            <a class="tarjeta" href={r(e.ruta)}>
              {e.portada && <div class="foto"><img src={r(peq(e.portada.src))} alt={e.portada.alt} loading="lazy" width="800" height="600" /></div>}
              <h3>{e.titulo}</h3>
            </a>
          ))}
        </div>
        <p style="margin-top:2.5rem"><a class="enlace" href={r('/entradas-del-blog/')}>Ver todas las guías</a></p>
      </div>
    </section>
  )}

  <section class="seccion cierre">
    <div class="ancho">
      <span class="etiqueta">¿Empezamos?</span><br />
      <a class="frase" href={r('/contacto/')}>Hablemos <span aria-hidden="true">→</span></a>
      <p>Llámanos al <a class="enlace" href={`tel:${EMPRESA.tel}`}>{EMPRESA.telefono}</a>, escríbenos o pásate por el taller de {EMPRESA.pueblo}. El presupuesto es sin compromiso y <a class="enlace" href={r('/preguntas-frecuentes/#p-el-precio-puede-cambiar')}>cerrado: pagas lo que pone</a>.</p>
    </div>
  </section>
  <script>import '../scripts/inmersivo.js';</script>
</Base>
