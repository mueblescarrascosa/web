---
// Dudas: buscador que responde al escribir y, por categorías (cocina, armarios, cómo trabajamos), sus calculadoras y sus preguntas juntas.
import Base from '../../layouts/Base.astro';
import { r, EMPRESA } from '../../lib/sitio.js';
import { TEMAS, DUDAS } from '../../datos/dudas.js';

const schema = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: DUDAS.map((d) => ({ '@type': 'Question', name: d.p, acceptedAnswer: { '@type': 'Answer', text: d.r } })) };
const populares = ['¿A qué altura pongo la encimera?', '¿Me cabe una isla?', '¿Qué encimera es mejor?', '¿Cuánto cuesta una cocina a medida?', '¿Qué fondo necesita un armario?', '¿A qué altura va la campana?'];
const id = (p) => 'p-' + p.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base titulo="Preguntas frecuentes: medidas, materiales y montaje de cocinas y armarios" descripcion="Resuelve al momento tus dudas sobre cocinas y armarios a medida: altura de la encimera, campana, pasillos, islas, encimeras, puertas, armarios y qué preparar antes del montaje. Con calculadoras." schema={schema}>
  <header class="cabeza-pagina ancho dudas-cabeza" data-entra>
    <span class="etiqueta">Dudas</span>
    <h1>Pregúntanos.</h1>
    <p class="entradilla">Medidas, materiales, armarios o qué preparar antes del montaje: escribe tu duda y te respondemos al momento, con las medidas que usamos en el taller.</p>
    <div class="buscador" role="search">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <input id="pregunta" type="search" autocomplete="off" placeholder="Por ejemplo: ¿a qué altura va la campana?" aria-label="Escribe tu duda" aria-controls="respuestas" />
    </div>
    <div class="populares" aria-label="Preguntas más buscadas">
      {populares.map((p) => <button type="button" data-p={p}>{p.replace(/^¿|\?$/g, '')}</button>)}
    </div>
  </header>

  <section class="ancho respuestas" id="respuestas" aria-live="polite" hidden></section>

  <nav class="ancho etiquetas cat-nav" aria-label="Categorías"><a href="#cat-cocina">Cocina</a><a href="#cat-armarios">Armarios y vestidores</a><a href="#cat-trabajo">Cómo trabajamos</a></nav>
  <section class="ancho categoria" id="cat-cocina">
    <div class="categoria-cabeza"><span class="etiqueta">Dudas de</span><h2>Cocina</h2><p class="suave">Medidas, materiales, colores y lo que hay que preparar antes del montaje, con sus calculadoras.</p></div>
    <div class="calculadoras">
    <article class="calc" id="calc-encimera">
      <span class="etiqueta">Calculadora</span>
      <h2>¿A qué altura tu encimera?</h2>
      <div class="calc-in">
        <div class="calc-mandos">
          <label>Estatura de quien más cocina <output id="est-valor">170 cm</output>
            <input id="estatura" type="range" min="145" max="200" value="170" step="1" />
          </label>
          <label class="interruptor"><input id="gas" type="checkbox" /><span></span>Placa de gas</label>
          <p class="resultado"><b id="enc-cm">88</b><span>cm de alto</span></p>
          <p class="suave" id="enc-detalle"></p>
        </div>
        <svg class="calc-dibujo" viewBox="0 0 220 240" aria-hidden="true">
          <line x1="0" y1="226" x2="220" y2="226" stroke="var(--linea)" stroke-width="2" />
          <g id="persona"><circle cx="60" r="11" /><rect x="45" width="30" rx="12" /><rect x="49" width="9" rx="4" /><rect x="62" width="9" rx="4" /></g>
          <rect id="mueble" x="95" width="115" fill="#a7845f" />
          <rect id="encimera-dib" x="90" width="125" height="5" fill="#ecebe8" />
          <line id="linea-enc" x1="0" x2="220" stroke="var(--azul-vivo)" stroke-dasharray="4 4" />
          <text id="txt-enc" x="216" text-anchor="end" fill="var(--azul-claro)" font-size="11" font-family="Inter, sans-serif"></text>
        </svg>
      </div>
    </article>
    <article class="calc" id="calc-isla">
      <span class="etiqueta">Calculadora</span>
      <h2>¿Te cabe una isla?</h2>
      <div class="calc-mandos">
        <label>Ancho de la cocina, de pared a pared <output id="ancho-valor">400 cm</output>
          <input id="ancho" type="range" min="240" max="700" value="400" step="5" />
        </label>
        <fieldset class="chips"><legend>En la pared de enfrente…</legend>
          <label><input type="radio" name="enfrente" value="1" checked /><span>Hay muebles</span></label>
          <label><input type="radio" name="enfrente" value="0" /><span>No hay muebles</span></label>
        </fieldset>
        <fieldset class="chips"><legend>La isla lleva…</legend>
          <label><input type="radio" name="tipo" value="60" /><span>Solo cajones</span></label>
          <label><input type="radio" name="tipo" value="90" checked /><span>Placa o fregadero</span></label>
          <label><input type="radio" name="tipo" value="120" /><span>Placa y barra para comer</span></label>
        </fieldset>
      </div>
      <div class="plano-isla" aria-hidden="true"><div class="tiras" id="tiras"></div><div class="pared-fin" id="pared-fin"></div></div>
      <p class="veredicto-isla" id="isla-veredicto"></p>
      <p class="suave" id="isla-detalle"></p>
    </article>
    <article class="calc" id="calc-muebles">
      <span class="etiqueta">Calculadora</span>
      <h2>¿Cuántos muebles caben en tu pared?</h2>
      <div class="calc-mandos">
        <label>Largo de la pared <output id="mc-valor">420 cm</output><input id="mc-largo" type="range" min="150" max="600" value="420" step="5" /></label>
        <fieldset class="chips"><legend>En esta pared van…</legend>
          <label><input type="checkbox" id="mc-frigo" checked /><span>Frigorífico</span></label>
          <label><input type="checkbox" id="mc-horno" checked /><span>Columna de horno</span></label>
        </fieldset>
        <fieldset class="chips"><legend>Lavavajillas</legend>
          <label><input type="radio" name="mc-lava" value="60" checked /><span>De 60</span></label><label><input type="radio" name="mc-lava" value="45" /><span>De 45</span></label><label><input type="radio" name="mc-lava" value="0" /><span>Sin lavavajillas</span></label>
        </fieldset>
        <div class="tiras tiras-muebles" id="mc-tiras"></div>
        <p class="veredicto-isla" id="mc-ver"></p>
        <p class="suave" id="mc-det"></p>
      </div>
    </article>
    <article class="calc" id="calc-triangulo">
      <span class="etiqueta">Calculadora</span>
      <h2>El triángulo de trabajo</h2>
      <div class="calc-in">
        <div class="calc-mandos">
          <label>Frigorífico → fregadero <output id="tr-a-v">180 cm</output><input id="tr-a" type="range" min="40" max="500" value="180" step="10" /></label>
          <label>Fregadero → placa <output id="tr-b-v">120 cm</output><input id="tr-b" type="range" min="40" max="500" value="120" step="10" /></label>
          <label>Placa → frigorífico <output id="tr-c-v">240 cm</output><input id="tr-c" type="range" min="40" max="500" value="240" step="10" /></label>
          <p class="veredicto-isla" id="tr-ver"></p>
          <p class="suave" id="tr-det"></p>
        </div>
        <svg class="calc-dibujo" viewBox="0 0 220 200" aria-hidden="true" id="tr-dib"></svg>
      </div>
    </article>
    <article class="calc" id="calc-horno">
      <span class="etiqueta">Calculadora</span>
      <h2>Horno y microondas en la columna</h2>
      <div class="calc-in">
        <div class="calc-mandos">
          <label>Estatura de quien más cocina <output id="hm-valor">170 cm</output><input id="hm-est" type="range" min="145" max="200" value="170" step="1" /></label>
          <p class="dato-grande"><b id="hm-horno">80</b><span>cm del suelo a la base del horno</span></p>
          <p class="dato-grande"><b id="hm-micro">130</b><span>cm a la base del microondas, encima</span></p>
          <p class="suave" id="hm-detalle"></p>
        </div>
        <svg class="calc-dibujo" viewBox="0 0 220 240" aria-hidden="true">
          <line x1="0" y1="226" x2="220" y2="226" stroke="var(--linea)" stroke-width="2" />
          <g id="hm-persona" fill="#5c5954"><circle cx="50" r="11" /><rect x="35" width="30" rx="12" /><rect x="39" width="9" rx="4" /><rect x="52" width="9" rx="4" /></g>
          <rect x="110" y="20" width="80" height="206" fill="#f1f0ec" />
          <rect id="hm-dib-horno" x="116" width="68" height="55" rx="3" fill="#1b1c1e" />
          <rect id="hm-dib-micro" x="116" width="68" height="35" rx="3" fill="#2a2c30" />
          <line id="hm-codo" x1="0" x2="220" stroke="var(--azul-vivo)" stroke-dasharray="4 4" />
          <text id="hm-codo-t" x="2" fill="var(--azul-claro)" font-size="10" font-family="Inter, sans-serif">codo</text>
        </svg>
      </div>
    </article>
    <article class="calc" id="calc-frigo">
      <span class="etiqueta">Calculadora</span>
      <h2>¿Qué frigorífico integrable cabe?</h2>
      <div class="calc-mandos">
        <label>Alto de la columna, sin el zócalo <output id="fr-valor">206 cm</output><input id="fr-col" type="range" min="140" max="250" value="206" step="1" /></label>
        <p class="dato-grande"><b id="fr-hueco">178</b><span>cm: el hueco de frigorífico que cabe</span></p>
        <div class="escala-frigo" id="fr-escala"></div>
        <p class="suave" id="fr-det"></p>
      </div>
    </article>
    <article class="calc" id="calc-enchufes">
      <span class="etiqueta">Calculadora</span>
      <h2>Enchufes y luz de tu cocina</h2>
      <div class="calc-mandos">
        <label>Largo de la encimera <output id="en-enc-v">300 cm</output><input id="en-enc" type="range" min="120" max="700" value="300" step="10" /></label>
        <label>Largo de los muebles altos <output id="en-alt-v">240 cm</output><input id="en-alt" type="range" min="0" max="600" value="240" step="10" /></label>
        <fieldset class="chips"><legend>Placa</legend>
          <label><input type="radio" name="en-placa" value="induccion" checked /><span>Inducción o vitro</span></label><label><input type="radio" name="en-placa" value="gas" /><span>Gas</span></label>
        </fieldset>
        <fieldset class="chips"><legend>Electrodomésticos</legend>
          <label><input type="checkbox" class="en-el" value="columna" checked /><span>Horno y micro en columna</span></label>
          <label><input type="checkbox" class="en-el" value="lava" checked /><span>Lavavajillas</span></label>
          <label><input type="checkbox" class="en-el" value="lavadora" /><span>Lavadora</span></label>
          <label><input type="checkbox" class="en-el" value="frigo" checked /><span>Frigorífico</span></label>
          <label><input type="checkbox" class="en-el" value="campana" checked /><span>Campana</span></label>
        </fieldset>
        <p class="dato-grande"><b id="en-total">9</b><span>tomas en total</span></p>
        <ul class="lista-tomas" id="en-lista"></ul>
        <p class="suave" id="en-det"></p>
      </div>
    </article>
    </div>
    <div class="todas">
    {TEMAS.filter(([k]) => ["medidas","materiales","obra"].includes(k)).map(([k, t]) => (
      <div class="tema" id={"tema-" + k}>
        <h3>{t}</h3>
        {DUDAS.filter((d) => d.tema === k).map((d) => (
          <details class="duda" id={id(d.p)}>
            <summary>{d.p}</summary>
            <div class="duda-r">
              <p>{d.r}</p>
              {(d.ir || d.calc) && <p class="duda-ir">{d.calc && <a class="enlace" href={"#calc-" + d.calc}>Usar la calculadora</a>}{d.ir && d.calc && ' · '}{d.ir && <a class="enlace" href={r(d.ir[0])}>{d.ir[1]}</a>}</p>}
            </div>
          </details>
        ))}
      </div>
    ))}
    </div>
  </section>
  <section class="ancho categoria" id="cat-armarios">
    <div class="categoria-cabeza"><span class="etiqueta">Dudas de</span><h2>Armarios y vestidores</h2><p class="suave">Fondo, barras, puertas, cuánto armario hace falta y vestidores.</p></div>
    <div class="calculadoras">
    <article class="calc" id="calc-cuanto">
      <span class="etiqueta">Calculadora</span>
      <h2>¿Cuánto armario necesitas?</h2>
      <div class="calc-mandos">
        <fieldset class="chips"><legend>Personas</legend>
          {[1, 2, 3, 4].map((n, i) => <label><input type="radio" name="ca-per" value={n} checked={i === 1} /><span>{n}</span></label>)}
        </fieldset>
        <fieldset class="chips"><legend>Ropa larga (abrigos, vestidos)</legend>
          <label><input type="radio" name="ca-larga" value="0" /><span>Poca</span></label><label><input type="radio" name="ca-larga" value="1" checked /><span>Normal</span></label><label><input type="radio" name="ca-larga" value="2" /><span>Mucha</span></label>
        </fieldset>
        <label>Pares de zapatos dentro del armario <output id="ca-zap-v">12</output><input id="ca-zap" type="range" min="0" max="60" value="12" step="2" /></label>
        <p class="dato-grande"><b id="ca-total">2,4</b><span>metros de armario</span></p>
        <div class="tiras tiras-muebles" id="ca-tiras"></div>
        <p class="suave" id="ca-det"></p>
        <p><a class="boton contorno" id="ca-juego" href={r('/disena-tu-armario/')}>Ábrelo en el juego</a></p>
      </div>
    </article>
    <article class="calc" id="calc-barras">
      <span class="etiqueta">Calculadora</span>
      <h2>¿A qué altura pongo las barras?</h2>
      <div class="calc-in">
        <div class="calc-mandos">
          <label>Tu estatura <output id="br-est-v">165 cm</output><input id="br-est" type="range" min="145" max="200" value="165" step="1" /></label>
          <label>Alto del armario <output id="br-alto-v">250 cm</output><input id="br-alto" type="range" min="200" max="280" value="250" step="5" /></label>
          <p class="dato-grande"><b id="br-larga">175</b><span>cm la barra para colgar largo</span></p>
          <p class="dato-grande"><b id="br-doble">195 y 100</b><span>cm con dos barras</span></p>
          <p class="suave" id="br-det"></p>
        </div>
        <svg class="calc-dibujo" viewBox="0 0 220 240" aria-hidden="true">
          <line x1="0" y1="226" x2="220" y2="226" stroke="var(--linea)" stroke-width="2" />
          <g id="br-persona" fill="#5c5954"><circle cx="45" r="11" /><rect x="30" width="30" rx="12" /><rect x="34" width="9" rx="4" /><rect x="47" width="9" rx="4" /></g>
          <line id="br-brazo" x1="58" x2="70" stroke="#5c5954" stroke-width="7" stroke-linecap="round" />
          <rect id="br-armario" x="95" width="115" fill="#f1f0ec" />
          <rect id="br-altillo" x="95" width="115" height="2" fill="#cfcdc8" />
          <line id="br-b1" x1="100" x2="205" stroke="#9aa0a6" stroke-width="2.5" />
          <line id="br-b2" x1="100" x2="205" stroke="#9aa0a6" stroke-width="2.5" />
          <line id="br-alcance" x1="0" x2="220" stroke="var(--azul-vivo)" stroke-dasharray="4 4" />
          <text id="br-alcance-t" x="2" fill="var(--azul-claro)" font-size="10" font-family="Inter, sans-serif">llegas</text>
        </svg>
      </div>
    </article>
    <article class="calc" id="calc-vestidor">
      <span class="etiqueta">Calculadora</span>
      <h2>¿Qué vestidor cabe en tu cuarto?</h2>
      <div class="calc-mandos">
        <label>Ancho del cuarto, de pared a pared <output id="vs-valor">260 cm</output><input id="vs-ancho" type="range" min="120" max="500" value="260" step="5" /></label>
        <ul class="formas-vestidor" id="vs-formas"></ul>
        <p class="suave">Fondo de los muebles: 60 cm. Pasos de la guía del taller: con muebles a un lado, 70 mínimo y 90 cómodo; a los dos lados, 80 y 100; con isla de 50, 90 a cada lado. <a class="enlace" href={r('/disena-tu-armario/')}>Diséñalo en el juego</a></p>
      </div>
    </article>
    <article class="calc" id="calc-buhardilla">
      <span class="etiqueta">Calculadora</span>
      <h2>Armario en buhardilla o bajo escalera</h2>
      <div class="calc-mandos">
        <label>Altura en la parte alta <output id="bu-alta-v">240 cm</output><input id="bu-alta" type="range" min="120" max="300" value="240" step="5" /></label>
        <label>Altura en la parte baja <output id="bu-baja-v">90 cm</output><input id="bu-baja" type="range" min="30" max="240" value="90" step="5" /></label>
        <label>Largo del hueco <output id="bu-largo-v">300 cm</output><input id="bu-largo" type="range" min="100" max="600" value="300" step="10" /></label>
        <svg class="dibujo-buhardilla" id="bu-dib" viewBox="0 0 320 170" aria-hidden="true"></svg>
        <ul class="leyenda-buhardilla"><li data-t="largo">Colgar largo</li><li data-t="doble">Dos barras</li><li data-t="corto">Colgar corto</li><li data-t="baldas">Baldas o cajones</li><li data-t="bajo">Cajones bajos</li></ul>
        <p class="suave" id="bu-det"></p>
      </div>
    </article>
    </div>
    <div class="todas">
    {TEMAS.filter(([k]) => ["armarios"].includes(k)).map(([k, t]) => (
      <div class="tema" id={"tema-" + k}>
        <h3>{t}</h3>
        {DUDAS.filter((d) => d.tema === k).map((d) => (
          <details class="duda" id={id(d.p)}>
            <summary>{d.p}</summary>
            <div class="duda-r">
              <p>{d.r}</p>
              {(d.ir || d.calc) && <p class="duda-ir">{d.calc && <a class="enlace" href={"#calc-" + d.calc}>Usar la calculadora</a>}{d.ir && d.calc && ' · '}{d.ir && <a class="enlace" href={r(d.ir[0])}>{d.ir[1]}</a>}</p>}
            </div>
          </details>
        ))}
      </div>
    ))}
    </div>
  </section>
  <section class="ancho categoria" id="cat-trabajo">
    <div class="categoria-cabeza"><span class="etiqueta">Dudas de</span><h2>Cómo trabajamos</h2><p class="suave">Presupuesto, medición, plazos, montaje, garantía y dónde estamos.</p></div>
    <div class="todas">
    {TEMAS.filter(([k]) => ["trabajo"].includes(k)).map(([k, t]) => (
      <div class="tema" id={"tema-" + k}>
        <h3>{t}</h3>
        {DUDAS.filter((d) => d.tema === k).map((d) => (
          <details class="duda" id={id(d.p)}>
            <summary>{d.p}</summary>
            <div class="duda-r">
              <p>{d.r}</p>
              {(d.ir || d.calc) && <p class="duda-ir">{d.calc && <a class="enlace" href={"#calc-" + d.calc}>Usar la calculadora</a>}{d.ir && d.calc && ' · '}{d.ir && <a class="enlace" href={r(d.ir[0])}>{d.ir[1]}</a>}</p>}
            </div>
          </details>
        ))}
      </div>
    ))}
    </div>
  </section>

  <section class="seccion claro cierre">
    <div class="ancho">
      <span class="etiqueta">¿No está tu duda?</span><br />
      <a class="frase" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Pregúntanos <span aria-hidden="true">→</span></a>
      <p>O llámanos al <a class="enlace" href={`tel:${EMPRESA.tel}`}>{EMPRESA.telefono}</a>.</p>
    </div>
  </section>

  <script>
    import { DUDAS } from '../../datos/dudas.js';
    const $ = (s, c = document) => c.querySelector(s), $$ = (s, c = document) => [...c.querySelectorAll(s)];
    const base = (document.querySelector('link[rel=icon]')?.getAttribute('href') || '/favicon.png').replace(/\/favicon\.png$/, '');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Buscador: sin tildes, con palabras parecidas y con palabras a medio escribir ──
    const limpia = (t) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9ñ ]+/g, ' ');
    const VACIAS = new Set('a al algo como con cual cuanto cuantos cuantas de del donde el en es esta este hay la las lo los me mi mis o para pongo por puedo que se si son su sus te tengo tu un una uno y ya hace hacer va van necesito necesita quiero'.split(' '));
    const raiz = (w) => w.replace(/(es|s)$/, '').replace(/(ción|cion)$/, 'cion');
    const palabras = (t) => limpia(t).split(/\s+/).filter((w) => w.length > 1 && !VACIAS.has(w)).map(raiz);
    const indice = DUDAS.map((d) => ({ d, p: palabras(d.p), c: palabras(d.c || ''), r: palabras(d.r) }));
    function buscar(q) {
      const qs = palabras(q); if (!qs.length) return [];
      return indice.map((x) => {
        let s = 0, tocadas = 0;
        qs.forEach((w) => {
          const en = (l) => l.some((v) => v === w || (w.length >= 3 && (v.startsWith(w) || (w.length >= 5 && w.startsWith(v) && v.length >= 4))));
          const a = en(x.p) ? 4 : 0, b = en(x.c) ? 3 : 0, c = en(x.r) ? 1 : 0;
          if (a || b || c) tocadas++; s += a + b + c;
        });
        return { d: x.d, s: s * (tocadas / qs.length) ** 2 };
      }).filter((x) => x.s >= 2).sort((a, b) => b.s - a.s).slice(0, 5);
    }
    const caja = $('#respuestas'), entrada = $('#pregunta');
    const enlace = (ir) => `<a class="enlace" href="${base}${ir[0]}">${ir[1]}</a>`;
    function mostrar() {
      const q = entrada.value.trim();
      if (q.length < 3) { caja.hidden = true; caja.innerHTML = ''; return; }
