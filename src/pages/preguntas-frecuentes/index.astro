    }
    $('#calc-enchufes').addEventListener('input', enchufes); enchufes();

    // ── ¿Cuánto armario? 100 cm por persona (guía), más si hay mucha ropa larga; zapatero de 60 = unos 12 pares ──
    function cuanto() {
      const per = +$('input[name=ca-per]:checked').value, larga = +$('input[name=ca-larga]:checked').value, zap = +$('#ca-zap').value;
      $('#ca-zap-v').textContent = zap;
      const largo = per * [30, 45, 70][larga], doble = per * 45, doblado = per * 30, zapatero = zap ? Math.ceil(zap / 12) * 60 : 0;
      let total = largo + doble + doblado + zapatero; total = Math.max(per * 100, Math.ceil(total / 10) * 10);
      const huecos = [['Colgar largo', largo, 'largo'], ['Dos barras', doble, 'doble'], ['Baldas y cajones', doblado, 'caj'], ...(zapatero ? [['Zapatero', zapatero, 'zap']] : [])];
      const suma = huecos.reduce((a, h) => a + h[1], 0), k = total / suma;
      $('#ca-total').textContent = (total / 100).toFixed(1).replace('.', ',');
      $('#ca-tiras').innerHTML = huecos.map(([n, w, c]) => `<span class="${c}" style="flex-basis:${(100 * w) / suma}%"><b>${Math.round(w * k)}</b>${n}</span>`).join('');
      $('#ca-det').textContent = `Unos ${total} cm de armario: ${per === 1 ? 'para una persona se cuentan unos 100 cm' : `se cuentan unos 100 cm por persona`}, más si hay mucha ropa larga o muchos zapatos. Con 60 cm de fondo (65 si son correderas).`;
      // Lo abre en el juego con un reparto de huecos parecido
      const mods = [], n = Math.max(1, Math.ceil(total / 100));
      const reparto = [['largo', largo], ['doble', doble], ['cajones', doblado], ...(zapatero ? [['zapatero', zapatero]] : [])];
      for (let i = 0; i < n; i++) mods.push(reparto[i % reparto.length][0]);
      $('#ca-juego').href = `${base}/disena-tu-armario/#ancho=${Math.min(450, total)}&alto=250&puertas=${total >= 140 ? 'correderas' : 'abatibles'}&mods=${mods.join(',')}`;
    }
    $('#calc-cuanto').addEventListener('input', cuanto); cuanto();

    // ── Buhardilla: qué cabe en cada tramo según la altura (colgar largo ≥ 175, dos barras ≥ 205, colgar corto ≥ 110, baldas ≥ 60) ──
    function buhardilla() {
      const alta = +$('#bu-alta').value, baja = Math.min(+$('#bu-baja').value, alta), largo = +$('#bu-largo').value;
      $('#bu-alta-v').textContent = alta + ' cm'; $('#bu-baja-v').textContent = baja + ' cm'; $('#bu-largo-v').textContent = largo + ' cm';
      const tramos = Math.max(2, Math.round(largo / 60)), w = largo / tramos, tipo = (h) => (h >= 205 ? 'doble' : h >= 175 ? 'largo' : h >= 110 ? 'corto' : h >= 60 ? 'baldas' : 'bajo');
      const kx = 300 / largo, ky = 150 / Math.max(alta, 1), X = (x) => 10 + x * kx, Yy = (h) => 160 - h * ky;
      let svg = `<polygon points="${X(0)},160 ${X(largo)},160 ${X(largo)},${Yy(baja)} ${X(0)},${Yy(alta)}" fill="#1d1d20" stroke="#55555c"/>`;
      const cuenta = {};
      for (let i = 0; i < tramos; i++) {
        const x0 = i * w, x1 = (i + 1) * w, h0 = alta - (alta - baja) * (x0 / largo), h1 = alta - (alta - baja) * (x1 / largo), t = tipo(Math.min(h0, h1));
        cuenta[t] = (cuenta[t] || 0) + w;
        svg += `<polygon points="${X(x0) + 1},159 ${X(x1) - 1},159 ${X(x1) - 1},${Yy(h1) + 2} ${X(x0) + 1},${Yy(h0) + 2}" class="bu-${t}"/>`;
      }
      $('#bu-dib').innerHTML = svg;
      const nombres = { doble: 'dos barras', largo: 'colgar largo', corto: 'colgar corto', baldas: 'baldas o cajones', bajo: 'cajones bajos o un arcón' };
      $('#bu-det').textContent = `Por tramos de unos ${Math.round(w)} cm: ${Object.entries(cuenta).map(([t, cm]) => `${Math.round(cm)} cm de ${nombres[t]}`).join(', ')}. El armario sigue la pendiente para no perder ni un hueco; las puertas se hacen a la medida de cada tramo.`;
    }
    $('#calc-buhardilla').addEventListener('input', buhardilla); buhardilla();
    // Si llegan con una pregunta en el enlace (#p-…), se abre
    const abierta = location.hash && $(location.hash); if (abierta?.tagName === 'DETAILS') abierta.open = true;
  </script>
