---
// «Mi proyecto»: junta lo último que el visitante ha diseñado en los juegos (se guarda solo en su navegador)
// para verlo de un vistazo, mandarlo al taller en un único mensaje o guardarlo como PDF.
import Base from '../../layouts/Base.astro';
import { r, EMPRESA } from '../../lib/sitio.js';
const juegos = [
  ['cocina', 'Tu cocina', '/combina-tu-cocina/', 'Combina tu cocina'],
  ['armario', 'Tu armario o vestidor', '/disena-tu-armario/', 'Diseña tu armario'],
  ['bano', 'Tu baño', '/combina-tu-bano/', 'Combina tu baño'],
  ['puerta', 'Tu puerta', '/configura-tu-puerta/', 'Configura tu puerta'],
  ['quiz', '¿Qué cocina va contigo?', '/que-cocina-va-contigo/', 'Hacer el quiz'],
];
---
<Base titulo="Mi proyecto" descripcion="Todo lo que has diseñado en los juegos de Muebles Carrascosa, junto: cocina, armario, baño y puertas. Mándalo al taller en un solo mensaje." noindex>
  <header class="cabeza-pagina ancho" data-entra>
    <span class="etiqueta">Mi proyecto</span>
    <h1>Todo lo que has diseñado.</h1>
    <p class="entradilla">Aquí se guarda lo último que has hecho en cada juego, solo en este navegador. Revísalo y mándanoslo todo junto: con esto ya sabemos qué te gusta.</p>
  </header>
  <section class="ancho proyecto" id="proyecto">
    <div class="proyecto-lista">
      {juegos.map(([k, t, h, boton]) => (
        <article class="tarjeta-proyecto" data-k={k} data-titulo={t}>
          <div class="tp-dibujo"></div>
          <div class="tp-texto">
            <h2>{t}</h2>
            <p class="suave tp-resumen">Todavía no lo has diseñado.</p>
            <div class="botones">
              <a class="boton contorno tp-abrir" href={r(h)}>{boton}</a>
              <button class="boton contorno tp-quitar" type="button" hidden>Quitar</button>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="proyecto-envio">
      <h2>Mándanoslo</h2>
      <label>Algo más que quieras contarnos (opcional)<textarea id="tp-nota" placeholder="Medidas aproximadas, pueblo, cuándo lo necesitas…"></textarea></label>
      <div class="botones">
        <a class="boton" id="tp-wa" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Enviar por WhatsApp</a>
        <a class="boton contorno" id="tp-correo" href={`mailto:${EMPRESA.email}`}>Por correo</a>
        <button class="boton contorno" type="button" id="tp-imprimir">Imprimir o guardar en PDF</button>
      </div>
      <p class="nota suave">Lo que has diseñado solo se guarda en tu navegador: no lo vemos hasta que nos lo mandas.</p>
    </div>
  </section>

  <script>
    import { leerProyecto, quitarDeProyecto } from '../../scripts/proyecto.js';
    const $ = (s, c = document) => c.querySelector(s), $$ = (s, c = document) => [...c.querySelectorAll(s)];
    function pintar() {
      const p = leerProyecto(), lineas = [];
      $$('.tarjeta-proyecto').forEach((t) => {
        const d = p[t.dataset.k];
        t.classList.toggle('vacia', !d);
        $('.tp-quitar', t).hidden = !d;
        $('.tp-dibujo', t).innerHTML = d?.svg || '';
        $('.tp-resumen', t).textContent = d ? d.resumen : 'Todavía no lo has diseñado.';
        if (d) { $('.tp-abrir', t).href = d.enlace; $('.tp-abrir', t).textContent = 'Abrir y cambiar'; lineas.push(`• ${t.dataset.titulo}: ${d.resumen}\n${d.enlace}`); }
      });
      const nota = $('#tp-nota').value.trim();
      const texto = `Hola, os mando mi proyecto hecho en vuestra web:\n\n${lineas.join('\n\n') || '(todavía sin diseños)'}${nota ? `\n\n${nota}` : ''}`;
      $('#tp-wa').href = 'https://wa.me/34653451270?text=' + encodeURIComponent(texto);
      $('#tp-correo').href = 'mailto:carrascosamuebles@gmail.com?subject=' + encodeURIComponent('Mi proyecto') + '&body=' + encodeURIComponent(texto);
    }
    $('#proyecto').addEventListener('click', (ev) => { const q = ev.target.closest('.tp-quitar'); if (q) { quitarDeProyecto(q.closest('.tarjeta-proyecto').dataset.k); pintar(); } });
    $('#tp-nota').addEventListener('input', pintar);
    $('#tp-imprimir').addEventListener('click', () => { window.medir?.('mi-proyecto/imprimir'); print(); });
    pintar();
  </script>
</Base>
