---
// Juego «Diseña tu armario»: armario con puertas (de frente) o vestidor (en perspectiva: lineal, en L, en C o con isla),
// con modelos de puerta, colores, el interior de cada hueco, lo que cabe y los consejos del taller.
import Base from '../../layouts/Base.astro';
import { r, EMPRESA } from '../../lib/sitio.js';
import { PUERTAS_ARMARIO, FORMAS, MODELOS_PUERTA, CRISTALES_LISTA, EXTERIORES, INTERIORES, TIRADORES_ARMARIO, PERFILES, INICIAL_A, consejos } from '../../datos/armario.js';
import { armario, DEFS_ARMARIO } from '../../scripts/armario-dibujo.js';

const buscar = (l, k) => l.find((x) => x.clave === k);
const e0 = { ...INICIAL_A, mods: INICIAL_A.mods.split(','), modsI: INICIAL_A.modsI.split(','), modsD: INICIAL_A.modsD.split(',') };
const d0 = armario(e0), n0 = consejos(e0, d0.datos);
const ext0 = buscar(EXTERIORES, e0.ext), int0 = buscar(INTERIORES, e0.int), tir0 = buscar(TIRADORES_ARMARIO, e0.tir), fr0 = buscar(EXTERIORES, e0.franja), cr0 = buscar(CRISTALES_LISTA, e0.cristal), pe0 = buscar(PERFILES, e0.perfil);
const vars0 = `--ext:${ext0.hex};--int:${int0.hex};--tir:${tir0.hex};--franja:${fr0.hex};--cristal:${cr0.hex};--cristal-op:${cr0.op};--v-ext:${ext0.dibujo === 'veta' ? 1 : 0};--v-int:${int0.dibujo === 'veta' ? 1 : 0};--v-franja:${fr0.dibujo === 'veta' ? 1 : 0};--t-int:${int0.dibujo === 'tela' ? 1 : 0};--perfil:${pe0.hex}`;
const R = '<rect x="11" y="5" width="18" height="30" rx="1" fill="none" stroke="currentColor" stroke-width="2"/>';
const ICONOS = {
  correderas: '<rect x="5" y="6" width="30" height="28" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 6v28" stroke="currentColor" stroke-width="2"/><path d="M9 20h7m-3-3 3 3-3 3M31 20h-7m3-3-3 3 3 3" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  abatibles: '<rect x="5" y="6" width="30" height="28" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 6v28" stroke="currentColor" stroke-width="2"/><rect x="16" y="16" width="2" height="8"/><rect x="22" y="16" width="2" height="8"/>',
  vestidor: '<path d="M5 34V6h30v28" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 12h24" stroke="currentColor" stroke-width="1.6"/><path d="M11 13v9M15 13v12M19 13v8M24 13v11M28 13v9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>',
  lineal: '<rect x="5" y="8" width="30" height="8" rx="1"/>',
  L: '<rect x="5" y="8" width="30" height="8" rx="1"/><rect x="5" y="8" width="8" height="25" rx="1"/>',
  C: '<rect x="5" y="8" width="30" height="8" rx="1"/><rect x="5" y="8" width="8" height="25" rx="1"/><rect x="27" y="8" width="8" height="25" rx="1"/>',
  isla: '<rect x="5" y="8" width="30" height="8" rx="1"/><rect x="5" y="8" width="7" height="25" rx="1"/><rect x="28" y="8" width="7" height="25" rx="1"/><rect x="17" y="21" width="6" height="11" rx="1"/>',
  lisa: R + '<rect x="24" y="16" width="2" height="8"/>',
  japonesa3: R + '<rect x="11" y="17.5" width="18" height="5"/><path d="M11 17.5h18M11 22.5h18" stroke="currentColor" stroke-width="1.4"/>',
  japonesa: R + '<rect x="11" y="12" width="18" height="7"/><path d="M11 12h18M11 19h18M11 27h18" stroke="currentColor" stroke-width="1.4"/>',
  rayas: R + '<path d="M11 12.5h18M11 20h18M11 27.5h18" stroke="currentColor" stroke-width="1.4"/>',
  moldura: R + '<rect x="14.5" y="8.5" width="11" height="23" fill="none" stroke="currentColor" stroke-width="1.3"/>',
  cristal: R + '<rect x="14" y="8" width="12" height="24" fill="currentColor" opacity=".25"/><path d="M16 12l6-3M16 17l8-4" stroke="currentColor" stroke-width="1"/>',
  cruz: R + '<rect x="14" y="14" width="12" height="12" fill="currentColor" opacity=".25"/><path d="M14 14l12 12M26 14l-12 12" stroke="currentColor" stroke-width="1.4"/><circle cx="20" cy="20" r="2.2"/>',
};
const icono = (g, l, nombreGrupo) => l.map((x) => `<label><input type="radio" name="${nombreGrupo}" value="${x.clave}" ${x.clave === e0[nombreGrupo] ? 'checked' : ''} /><span class="muestra icono"><svg viewBox="0 0 40 40" aria-hidden="true">${ICONOS[x.clave]}</svg></span><span class="texto-muestra">${x.nombre}</span></label>`).join('');
const colores = (l, nombreGrupo) => l.map((x) => `<label title="${x.nombre}"><input type="radio" name="${nombreGrupo}" value="${x.clave}" ${x.clave === e0[nombreGrupo] ? 'checked' : ''} /><span class="muestra ${x.dibujo || ''} ${x.tipo ? 't-' + x.tipo : ''}" style="--c:${x.hex}"></span><span class="nombre-muestra">${x.nombre}</span></label>`).join('');
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Diseña tu armario o vestidor', applicationCategory: 'DesignApplication', operatingSystem: 'Navegador web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, provider: { '@type': 'Organization', name: EMPRESA.nombre } };
---
<Base titulo="Diseña tu armario o vestidor" descripcion="Juega a diseñar tu armario o vestidor: correderas, abatibles, japonesa o de cristal; vestidor lineal, en L, en C o con isla; colores y el interior de cada hueco. Te decimos cuánta ropa cabe y cómo mejorarlo. Por Muebles Carrascosa, Jaén." schema={schema}>
  <header class="cabeza-pagina ancho" data-entra>
    <span class="etiqueta">Juego · Diseña tu armario o vestidor</span>
    <h1>¿Cabe todo en tu armario?</h1>
    <p class="entradilla">Pon las medidas, elige armario o vestidor, el modelo de puerta y los colores, y toca cada hueco para cambiar su interior. Te diremos cuánta ropa cabe y qué mejorarías, con las medidas que usamos en el taller.</p>
  </header>

  <section class="ancho combina armario-juego" id="combina">
    <div class="combina-vista">
      <div class="lienzo">
        <svg class="armario" viewBox={d0.vista} role="img" aria-label="Dibujo del armario con su interior" style={vars0} data-tirador={tir0.tipo} data-abierto="0" data-modo="frente" data-led={e0.led} set:html={DEFS_ARMARIO + d0.s} />
        <button class="boton-luz boton-abrir" type="button" aria-pressed="false"><span>Abrir puertas</span></button>
      </div>
      <div class="nota" aria-live="polite">
        <div class="anillo">
          <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="42" class="pista-anillo" /><circle cx="50" cy="50" r="42" class="valor" style={`stroke-dashoffset:${263.9 * (1 - n0.puntos / 100)}`} /></svg>
          <b class="puntos">{n0.puntos}</b>
        </div>
        <div>
          <p class="veredicto">{n0.veredicto}</p>
          <p class="estilo">Para unas <span>{n0.personas}</span> personas</p>
        </div>
        <div class="plano-vestidor" hidden aria-hidden="true"></div>
      </div>
      <ul class="cabe" aria-label="Lo que cabe">
        <li><b data-dato="perchas">{d0.datos.perchas}</b>prendas colgadas</li>
        <li><b data-dato="montones">{d0.datos.montones}</b>montones de ropa</li>
        <li><b data-dato="zapatos">{d0.datos.zapatos}</b>pares de zapatos</li>
        <li><b data-dato="cajones">{d0.datos.cajones}</b>cajones</li>
      </ul>
      <ul class="motivos">
        {n0.bien.map((t) => <li class="bien">{t}</li>)}{n0.ojo.map((t) => <li class="ojo">{t}</li>)}
      </ul>
    </div>

    <div class="combina-mandos">
      <fieldset class="muestras" data-grupo="puertas">
        <legend>Tipo <span class="elegido">{buscar(PUERTAS_ARMARIO, e0.puertas).nombre}</span></legend>
        <div class="lista-muestras con-iconos" set:html={icono(null, PUERTAS_ARMARIO, 'puertas')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="forma" data-solo="vestidor">
        <legend>Forma del vestidor <span class="elegido">{buscar(FORMAS, e0.forma).nombre}</span></legend>
        <div class="lista-muestras con-iconos" set:html={icono(null, FORMAS, 'forma')} />
      </fieldset>
      <fieldset class="muestras">
        <legend>Medidas <span class="elegido medidas-texto"></span></legend>
        <div class="calc-mandos">
          <label><span class="rotulo-ancho">Ancho</span> <output id="ancho-valor">{e0.ancho} cm</output><input id="ancho" type="range" min="100" max="450" step="10" value={e0.ancho} /></label>
          <label class="solo-lados">Fondo de los laterales <output id="lado-valor">{e0.lado} cm</output><input id="lado" type="range" min="100" max="260" step="10" value={e0.lado} /></label>
          <label>Alto <output id="alto-valor">{e0.alto} cm</output><input id="alto" type="range" min="200" max="270" step="5" value={e0.alto} /></label>
        </div>
      </fieldset>
      <fieldset class="muestras">
        <legend>Interior de cada hueco <span class="elegido">toca para cambiarlo</span></legend>
        <div class="huecos" id="huecos"></div>
      </fieldset>
      <fieldset class="muestras">
        <legend>Luz <span class="elegido texto-led">{e0.led === '1' ? 'LED encendido' : 'Sin LED'}</span></legend>
        <label class="interruptor"><input id="led" type="checkbox" checked={e0.led === '1'} /><span></span>Luz LED en las barras y dentro del armario</label>
      </fieldset>
      <fieldset class="muestras" data-grupo="modelo" data-solo="puertas">
        <legend>Modelo de puerta <span class="elegido">{buscar(MODELOS_PUERTA, e0.modelo).nombre}</span></legend>
        <div class="lista-muestras con-iconos" set:html={icono(null, MODELOS_PUERTA, 'modelo')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="perfil" data-solo="correderas">
        <legend>Herraje de las correderas <span class="elegido">{pe0.nombre}</span></legend>
        <div class="lista-muestras" set:html={colores(PERFILES, 'perfil')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="cristal" data-solo="cristal">
        <legend>Cristal <span class="elegido">{cr0.nombre}</span></legend>
        <div class="lista-muestras" set:html={colores(CRISTALES_LISTA, 'cristal')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="ext">
        <legend><span class="rotulo-ext">Puertas y exterior</span> <span class="elegido">{ext0.nombre}</span></legend>
        <div class="lista-muestras" set:html={colores(EXTERIORES, 'ext')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="franja" data-solo="japonesa">
        <legend>Franja de la puerta japonesa <span class="elegido">{fr0.nombre}</span></legend>
        <div class="lista-muestras" set:html={colores(EXTERIORES, 'franja')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="int">
        <legend>Interior <span class="elegido">{int0.nombre}</span></legend>
        <div class="lista-muestras" set:html={colores(INTERIORES, 'int')} />
      </fieldset>
      <fieldset class="muestras" data-grupo="tir" data-solo="abatibles">
        <legend>Tiradores <span class="elegido">{tir0.nombre}</span></legend>
        <div class="lista-muestras" set:html={colores(TIRADORES_ARMARIO, 'tir')} />
      </fieldset>
      <div class="botones combina-botones">
        <button class="boton contorno" type="button" data-accion="inspirame">✦ Inspírame</button>
        <button class="boton contorno" type="button" data-accion="descargar">Descargar imagen</button>
        <button class="boton contorno" type="button" data-accion="compartir">Compartir enlace</button>
        <a class="boton" data-accion="whatsapp" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Mándaselo al taller</a>
      </div>
      <p class="aviso-colores">Se guarda solo en <a class="enlace" href={r('/mi-proyecto/')}>tu proyecto</a>. Dibujo orientativo: el interior lo decidimos contigo según lo que guardas, y en el taller te enseñamos las muestras reales.</p>
    </div>
  </section>

  <article class="contenido consejos-color">
    <h2>Medidas para organizar un armario o un vestidor</h2>
    <p>Las que usamos en el taller al distribuir un armario o un vestidor:</p>
    <ul>
      <li><strong>Fondo:</strong> 60 cm (55 útiles). Con puertas correderas, 65, porque las guías ocupan 8–9 cm.</li>
      <li><strong>Ancho:</strong> unos 100 cm por persona, en módulos de 60 a 100 cm: una barra de más de 100 sin apoyo se comba.</li>
      <li><strong>Colgar largo:</strong> hueco de 150–170 cm, con la barra a 170–180 cm del suelo. Para camisas y chaquetas caben dos barras, a unos 100 y 200 cm.</li>
      <li><strong>Baldas:</strong> cada 30–40 cm (20 para ropa fina). <strong>Cajones:</strong> de 12–20 cm, y la cajonera por debajo de 100 cm para ver dentro.</li>
      <li><strong>Altillo:</strong> de 35–50 cm, desde unos 180–190 cm. Una barra por encima de 200 necesita elevador.</li>
      <li><strong>Delante:</strong> 80–90 cm libres para abrir puertas y cajones.</li>
      <li><strong>Vestidor:</strong> con muebles a un lado, 70 cm de paso mínimo (90 cómodo); a los dos lados, 80 (100 cómodo). Con isla, 90 cm a cada lado: un cuarto de unos 330–350 cm entre paredes.</li>
    </ul>
    <p>Más ideas en la guía <a href={r('/2026/11/03/interior-armario-empotrado/')}>cómo organizar el interior de un armario</a>, y mira <a href={r('/armarios/')}>armarios y vestidores que hemos hecho</a>. ¿Tienes dudas? <a href={r('/preguntas-frecuentes/')}>Pregúntanos</a>.</p>
  </article>

  <section class="seccion claro cierre">
    <div class="ancho">
      <span class="etiqueta">¿Te gusta tu armario?</span><br />
      <a class="frase" href={r('/contacto/')}>Hablemos <span aria-hidden="true">→</span></a>
      <div class="botones"><a class="boton" href={r('/contacto/')}>Pide presupuesto</a><a class="boton contorno" href={EMPRESA.whatsapp} target="_blank" rel="noopener">Escríbenos por WhatsApp</a></div>
    </div>
  </section>

  <script>
    import { PUERTAS_ARMARIO, FORMAS, MODELOS_PUERTA, CRISTALES_LISTA, EXTERIORES, INTERIORES, TIRADORES_ARMARIO, PERFILES, SOLO_CORREDERAS, TIPOS, ORDEN_TIPOS, INICIAL_A, PROPUESTAS_A, consejos, modulosPara, correderas } from '../../datos/armario.js';
    import { armario, vestidor, plano, DEFS_ARMARIO } from '../../scripts/armario-dibujo.js';
    import { imagenConMarca, descargarOCompartir } from '../../scripts/exportar.js';
    import { guardarEnProyecto, dibujoActual } from '../../scripts/proyecto.js';
    const $ = (s, c = document) => c.querySelector(s), $$ = (s, c = document) => [...c.querySelectorAll(s)];
    const svg = $('svg.armario'), quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const listas = { puertas: PUERTAS_ARMARIO, forma: FORMAS, modelo: MODELOS_PUERTA, cristal: CRISTALES_LISTA, ext: EXTERIORES, franja: EXTERIORES, int: INTERIORES, tir: TIRADORES_ARMARIO, perfil: PERFILES };
    const LISTAS_HUECOS = ['mods', 'modsI', 'modsD'], PARED = { f: 'mods', i: 'modsI', d: 'modsD' }, NOMBRE_PARED = { f: 'Fondo', i: 'Izquierda', d: 'Derecha' };
    const nuevo = (o) => ({ ...INICIAL_A, ...o, ...Object.fromEntries(LISTAS_HUECOS.map((k) => [k, String(o[k] ?? INICIAL_A[k]).split(',')])) });
    let e = nuevo({}), abierto = false, mostrado = null, dibujado = '', datosActuales = null;

    const deEnlace = () => {
      const p = new URLSearchParams(location.hash.slice(1));
      Object.keys(listas).forEach((k) => { if (listas[k].some((x) => x.clave === p.get(k))) e[k] = p.get(k); });
      if (p.get('led') === '1' || p.get('led') === '0') e.led = p.get('led');
      [['ancho', 100, 450], ['alto', 200, 270], ['lado', 100, 260]].forEach(([k, a, b]) => { const v = +p.get(k); if (v >= a && v <= b) e[k] = v; });
      LISTAS_HUECOS.forEach((k) => { if (p.get(k)) e[k] = p.get(k).split(',').filter((t) => TIPOS[t]); });
    };
    const aEnlace = () => history.replaceState(null, '', '#' + new URLSearchParams(Object.fromEntries(Object.entries(e).map(([k, v]) => [k, Array.isArray(v) ? v.join(',') : v]))).toString());
    const busca = (k) => listas[k].find((x) => x.clave === e[k]);
    const esVest = () => e.puertas === 'vestidor';
    const contar = (el, de, a) => {
      if (quieto || de == null || de === a) { el.textContent = a; return; }
      const t0 = performance.now(), d = 600;
      const paso = (t) => { const p = Math.min(1, (t - t0) / d); el.textContent = Math.round(de + (a - de) * (1 - (1 - p) ** 3)); if (p < 1) requestAnimationFrame(paso); };
      requestAnimationFrame(paso);
    };
    const completar = (k, n) => { while (e[k].length < n) e[k].push(ORDEN_TIPOS[(e[k].length + LISTAS_HUECOS.indexOf(k)) % ORDEN_TIPOS.length]); };

    function pintar() {
      const vest = esVest();
      // Correderas solo si la hoja no queda demasiado esbelta (cabecearía); si no, pasan a abatibles
      const corr = correderas(e.ancho, e.alto), opCorr = $('input[name="puertas"][value="correderas"]');
      opCorr.disabled = !corr.ok; opCorr.closest('label').classList.toggle('no-disponible', !corr.ok);
      opCorr.closest('label').title = corr.ok ? 'Correderas' : `Con este ancho cada hoja sería de ${corr.hoja} × ${corr.H} cm: demasiado esbelta, cabecearía`;
      if (e.puertas === 'correderas' && !corr.ok) { e.puertas = 'abatibles'; if (SOLO_CORREDERAS.includes(e.modelo)) e.modelo = 'lisa'; history.replaceState(null, '', '#' + new URLSearchParams(Object.fromEntries(Object.entries(e).map(([k, v]) => [k, Array.isArray(v) ? v.join(',') : v]))).toString()); }
      // Japonesas y cuatro paneles solo en correderas
      if (e.puertas === 'abatibles' && SOLO_CORREDERAS.includes(e.modelo)) e.modelo = 'lisa';
      $$('input[name="modelo"]').forEach((i) => (i.closest('label').hidden = e.puertas === 'abatibles' && SOLO_CORREDERAS.includes(i.value)));
      completar('mods', modulosPara(e.ancho)); completar('modsI', modulosPara(e.lado)); completar('modsD', modulosPara(e.lado));
      const d = vest ? vestidor(e) : armario({ ...e, mods: e.mods.slice(0, modulosPara(e.ancho)) });
      const clave = JSON.stringify([vest, e.ancho, e.alto, e.lado, e.puertas, e.forma, e.modelo, e.mods, e.modsI, e.modsD]);
      if (clave !== dibujado) {
        const antes = {}; $$('[data-dato]').forEach((b) => (antes[b.dataset.dato] = +b.textContent));
        svg.setAttribute('viewBox', d.vista); svg.innerHTML = DEFS_ARMARIO + d.s; dibujado = clave; svg.dataset.modo = vest ? 'vestidor' : 'frente';
        Object.entries(d.datos).forEach(([k, v]) => { const b = $(`[data-dato="${k}"]`); if (b) contar(b, antes[k], v); });
      }
      datosActuales = d.datos;
      const ext = busca('ext'), int = busca('int'), tir = busca('tir'), fr = busca('franja'), cr = busca('cristal'), pe = busca('perfil');
      [['--ext', ext.hex], ['--int', int.hex], ['--tir', tir.hex], ['--franja', fr.hex], ['--cristal', cr.hex], ['--cristal-op', cr.op], ['--v-ext', ext.dibujo === 'veta' ? 1 : 0], ['--v-int', int.dibujo === 'veta' ? 1 : 0], ['--v-franja', fr.dibujo === 'veta' ? 1 : 0], ['--t-int', int.dibujo === 'tela' ? 1 : 0], ['--perfil', pe.hex]].forEach(([k, v]) => svg.style.setProperty(k, v));
      svg.dataset.tirador = tir.tipo; svg.dataset.abierto = abierto || vest ? '1' : '0'; svg.dataset.led = e.led;
      $('#led').checked = e.led === '1'; $('.texto-led').textContent = e.led === '1' ? 'LED encendido' : 'Sin LED';
      const pv = $('.plano-vestidor'); pv.hidden = !vest; if (vest) pv.innerHTML = '<span>Visto desde arriba</span>' + plano(e);
      const ba = $('.boton-abrir'); ba.hidden = vest; ba.setAttribute('aria-pressed', String(abierto)); $('span', ba).textContent = abierto ? 'Cerrar puertas' : 'Abrir puertas';
      // Qué grupos se ven según lo elegido
      const cristal = e.modelo === 'cristal' || e.modelo === 'cruz';
      $$('fieldset[data-solo]').forEach((f) => { const s = f.dataset.solo; f.hidden = !(s === 'vestidor' ? vest : s === 'puertas' ? !vest : s === 'cristal' ? !vest && cristal : s === 'japonesa' ? !vest && (e.modelo === 'japonesa' || e.modelo === 'japonesa3') : s === 'abatibles' ? e.puertas === 'abatibles' : s === 'correderas' ? e.puertas === 'correderas' : true); });
      const lados = vest && e.forma !== 'lineal';
      $('.solo-lados').hidden = !lados; $('.rotulo-ancho').textContent = vest ? 'Ancho de la pared del fondo' : 'Ancho';
      $('.rotulo-ext').textContent = vest ? 'Cantos y exterior' : 'Puertas y exterior';
      ['ancho', 'alto', 'lado'].forEach((k) => { $('#' + k + '-valor').textContent = e[k] + ' cm'; $('#' + k).value = e[k]; });
      $('.medidas-texto').textContent = `${e.ancho} × ${e.alto} cm${lados ? ` · laterales de ${e.lado}` : ''}`;
      $$('fieldset[data-grupo]').forEach((f) => { const k = f.dataset.grupo, x = busca(k); if (!x) return; $('.elegido', f).textContent = x.nombre; const i = $(`input[value="${e[k]}"]`, f); if (i) i.checked = true; });
